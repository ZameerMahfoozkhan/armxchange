---
interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showSubtext?: boolean;
}

const { variant = 'light', size = 'md' } = Astro.props;

const height = size === 'sm' ? 38 : size === 'lg' ? 68 : size === 'xl' ? 88 : 48;
const width = height * 2;
---

<div class="brand-logo-wrap" style="display: inline-flex; align-items: center; line-height: 1;">
  <img 
    src="/images/brand/armxchange-logo.webp" 
    alt="ArmXchange - India's 10m Air Rifle and Air Pistol Sports Marketplace" 
    width={width}
    height={height}
    decoding="async"
    loading="eager"
    style={`height: ${height}px; width: auto; max-width: 100%; object-fit: contain; display: block; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.22));`}
  />
</div>
