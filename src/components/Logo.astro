---
interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showSubtext?: boolean;
}

const { variant = 'light', size = 'md' } = Astro.props;

const height = size === 'sm' ? 36 : size === 'lg' ? 62 : size === 'xl' ? 80 : 44;
const width = Math.round(height * 3);
---

<div class="brand-logo-wrap" style="display: inline-flex; align-items: center; line-height: 1;">
  <img 
    src="/images/brand/armxchange-logo.webp" 
    alt="ArmXchange - Shooting Sports Equipment" 
    width={width}
    height={height}
    decoding="async"
    loading="eager"
    style={`height: ${height}px; width: auto; max-width: 100%; object-fit: contain; display: block;`}
  />
</div>
