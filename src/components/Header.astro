<style>
  /* Base Layout & Brand */
  .header-container {
    height: 100%;
  }

  .site-brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s var(--ease-out);
    flex-shrink: 0;
  }

  .site-brand-link:hover {
    opacity: 0.88;
  }

  /* Nav Links Architecture - Clean, Open, High-End */
  .site-nav {
    display: flex;
    align-items: center;
    margin: 0 auto;
  }

  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 500;
    color: #475569;
    padding: 7px 11px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav-link:hover {
    color: #0B0F17;
    background: rgba(15, 23, 42, 0.05);
    transform: translateY(-1px);
  }

  .site-nav-link.active {
    color: #0B0F17;
    background: rgba(15, 23, 42, 0.07);
    font-weight: 600;
  }

  /* Pre-Owned Verified Special Accent */
  .site-nav-link.nav-link-preowned {
    color: #0B0F17;
    font-weight: 600;
  }

  .nav-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #059669;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.24);
    animation: navDotPulse 2.4s infinite ease-in-out;
  }

  @keyframes navDotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .nav-verified-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #F0FDF4;
    color: #166534;
    border: 1px solid #BBF7D0;
    padding: 1.5px 6px;
    border-radius: 4px;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    transition: all 0.18s ease;
  }

  .nav-verified-badge svg {
    color: #059669;
    flex-shrink: 0;
  }

  .site-nav-link.nav-link-preowned:hover {
    background: rgba(15, 23, 42, 0.05);
    color: #0B0F17;
  }

  .site-nav-link.nav-link-preowned:hover .nav-verified-badge {
    background: #DCFCE7;
    border-color: #86EFAC;
    color: #14532D;
  }

  .site-nav-link.nav-link-preowned.active {
    background: rgba(15, 23, 42, 0.07);
    color: #0B0F17;
  }

  /* Desktop Dropdown Architecture */
  .nav-item-dropdown {
    position: relative;
    list-style: none;
  }

  .nav-chevron {
    color: #94A3B8;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), color 0.18s ease;
    flex-shrink: 0;
  }

  .nav-item-dropdown:hover .nav-chevron,
  .nav-item-dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
    color: #0B0F17;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 320px;
    background: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 14px;
    padding: 10px;
    box-shadow: 0 16px 38px -6px rgba(11, 15, 23, 0.14), 0 4px 14px -2px rgba(11, 15, 23, 0.05);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.98);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    z-index: 1000;
  }

  /* Hover Bridge: prevents menu from closing when moving mouse across gap */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
    background: transparent;
  }

  .nav-item-dropdown:hover .nav-dropdown-menu,
