                  <div class="dropdown-item-text">
                    <div class="dropdown-item-title-row">
                      <span class="dropdown-item-title">Match Sights & Scopes</span>
                      <span class="dropdown-item-pill">Scope</span>
                    </div>
                    <p class="dropdown-item-desc">Precision MEC Spy diopters, variable irises & optics</p>
                  </div>
