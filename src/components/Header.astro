---
import { CONTACT_INFO } from '../data/products';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Active path helper
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/' || currentPath === '';
  const cleanPath = path.replace(/^\/|\/$/g, '');
  return currentPath.includes(cleanPath);
};
---

<header class="site-header" id="siteHeader">
  <div class="container header-container">
    <div class="site-header-inner">
      <!-- ArmXchange Brand Logo -->
      <a href="/" class="site-brand-link" aria-label="ArmXchange - Shooting Sports Marketplace Homepage">
        <Logo variant="dark" size="md" />
      </a>

      <!-- Desktop & Laptop Navigation Menu -->
      <nav class="site-nav" aria-label="Main Navigation">
        <ul class="site-nav-links">
          <li>
            <a 
              href="/second-hand-weapons/" 
              class={`site-nav-link nav-link-preowned ${isActive('/second-hand-weapons') ? 'active' : ''}`}
            >
              <span class="nav-pulse-dot" aria-hidden="true"></span>
              <span>Pre-Owned</span>
              <span class="nav-verified-badge">Verified</span>
            </a>
          </li>
          <li>
            <a 
              href="/new-weapons/" 
              class={`site-nav-link ${isActive('/new-weapons') ? 'active' : ''}`}
            >
              New Weapons
            </a>
          </li>
          <li>
            <a 
              href="/accessories/" 
              class={`site-nav-link ${isActive('/accessories') ? 'active' : ''}`}
            >
              Accessories
            </a>
          </li>
          <li>
            <a 
              href="/pellets/" 
              class={`site-nav-link ${isActive('/pellets') ? 'active' : ''}`}
            >
              Pellets
            </a>
          </li>
          <li>
            <a 
              href="/how-it-works/" 
              class={`site-nav-link ${isActive('/how-it-works') ? 'active' : ''}`}
            >
              How It Works
            </a>
          </li>
          <li>
            <a 
              href="/about-armxchange/" 
              class={`site-nav-link ${isActive('/about-armxchange') ? 'active' : ''}`}
            >
              Founder
            </a>
          </li>
          <li>
            <a 
              href="/contact/" 
              class={`site-nav-link ${isActive('/contact') ? 'active' : ''}`}
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="site-header-actions">
        <!-- Desktop WhatsApp Concierge Button -->
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about competition shooting sports equipment on ArmXchange.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta-whatsapp"
          aria-label="Direct WhatsApp Consultation with Coach Pranatpal Singh"
        >
          <span class="nav-wa-beacon" aria-hidden="true">
            <WhatsAppIcon size={16} />
            <span class="nav-wa-status-dot"></span>
          </span>
          <span class="nav-cta-text">
            <span class="nav-cta-text-full">Enquire on WhatsApp</span>
            <span class="nav-cta-text-short">WhatsApp</span>
          </span>
        </a>

        <!-- Mobile Quick WhatsApp Tap Button -->
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about shooting sports equipment on ArmXchange.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-quick-whatsapp"
          aria-label="Direct WhatsApp Consultation"
        >
          <WhatsAppIcon size={18} />
          <span class="mobile-wa-status-dot" aria-hidden="true"></span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobileMenuBtn" class="mobile-toggle-btn" aria-label="Toggle Navigation Menu" aria-expanded="false" aria-controls="mobileDrawer">
          <span class="hamburger-box">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop & Sheet -->
<div id="drawerBackdrop" class="mobile-drawer-backdrop" aria-hidden="true"></div>

<aside id="mobileDrawer" class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation Menu">
  <div class="mobile-drawer-inner">
    <div class="mobile-drawer-header">
      <a href="/" class="drawer-brand" aria-label="ArmXchange Homepage">
        <Logo variant="dark" size="sm" />
      </a>
      <button id="closeDrawerBtn" class="drawer-close-btn" aria-label="Close Navigation Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Verified Athlete Status Pill -->
    <div class="drawer-coach-pill">
      <span class="live-pulse-dot" aria-hidden="true"></span>
      <span>National Shooter & Coach Consultation</span>
    </div>

    <div class="drawer-scroll-body">
      <!-- Section 1: Marketplace Categories -->
      <div class="drawer-group">
        <div class="drawer-group-title">EQUIPMENT MARKETPLACE</div>
        <ul class="drawer-links">
          <li>
            <a href="/second-hand-weapons/" class="drawer-link drawer-link-preowned">
              <div class="drawer-link-content">
                <span class="preowned-dot" aria-hidden="true"></span>
                <span>Pre-Owned Weapons</span>
              </div>
              <span class="drawer-badge-red">Verified Priority</span>
            </a>
          </li>
          <li>
            <a href="/new-weapons/" class="drawer-link">
              <span>New Competition Weapons</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/accessories/" class="drawer-link">
              <span>Shooting Accessories & Boots</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/pellets/" class="drawer-link">
              <span>RWS Match Pellets</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Section 2: Verification & Services -->
      <div class="drawer-group">
        <div class="drawer-group-title">ATHLETE SERVICES & INFO</div>
        <ul class="drawer-links">
          <li>
            <a href="/how-it-works/" class="drawer-link">
              <span>How ArmXchange Works</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/pre-owned-equipment-guide/" class="drawer-link">
              <span>Used Equipment Guide</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/about-armxchange/" class="drawer-link">
              <span>Founder Pranatpal Singh</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/contact/" class="drawer-link">
              <span>Official Contact & Support</span>
              <span class="drawer-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Drawer Footer Card -->
    <div class="drawer-footer">
      <a 
        href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about shooting sports equipment on ArmXchange.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="drawer-whatsapp-cta"
      >
        <WhatsAppIcon size={19} />
        <span>Direct WhatsApp Consultation</span>
      </a>
      <p class="drawer-guarantee-caption">
        Direct athlete-to-athlete consultation &bull; Cylinder validity verified
      </p>
    </div>
  </div>
</aside>

<style>
  /* Base Layout & Brand */
  .header-container {
    height: 100%;
  }

  .site-brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s var(--ease-out);
    flex-shrink: 0;
  }

  .site-brand-link:hover {
    opacity: 0.88;
  }

  /* Nav Links Architecture - Clean, Open, High-End */
  .site-nav {
    display: flex;
    align-items: center;
    margin: 0 auto;
  }

  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 500;
    color: #475569;
    padding: 7px 11px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav-link:hover {
    color: #0B0F17;
    background: rgba(15, 23, 42, 0.05);
    transform: translateY(-1px);
  }

  .site-nav-link.active {
    color: #0B0F17;
    background: rgba(15, 23, 42, 0.07);
    font-weight: 600;
  }

  /* Pre-Owned Verified Special Accent */
  .site-nav-link.nav-link-preowned {
    color: #0B0F17;
    font-weight: 600;
  }

  .nav-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D9263E;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px rgba(217, 38, 62, 0.2);
  }

  .nav-verified-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: #FFF1F2;
    color: #D9263E;
    border: 1px solid #FFE4E6;
    padding: 1px 5px;
    border-radius: 4px;
    line-height: 1.2;
    transition: background 0.18s ease;
  }

  .site-nav-link.nav-link-preowned:hover {
    background: #FFF1F2;
    color: #D9263E;
  }

  .site-nav-link.nav-link-preowned:hover .nav-verified-badge {
    background: #FFE4E6;
  }

  .site-nav-link.nav-link-preowned.active {
    background: #FFF1F2;
    color: #D9263E;
  }

  /* Actions Area */
  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Desktop WhatsApp CTA Button */
  .nav-cta-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: linear-gradient(180deg, #161E2E 0%, #0B0F17 100%);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 8px 18px;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 2px 8px rgba(11, 15, 23, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-cta-whatsapp:hover {
    background: linear-gradient(180deg, #1E293B 0%, #0F172A 100%);
    color: #FFFFFF;
    border-color: rgba(37, 211, 102, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(11, 15, 23, 0.26), 0 0 14px rgba(37, 211, 102, 0.16);
  }

  .nav-cta-whatsapp:active {
    transform: translateY(0) scale(0.98);
  }

  .nav-wa-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #25D366;
  }

  .nav-wa-status-dot {
    position: absolute;
    top: -1px;
    right: -2px;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #10B981;
    border: 1.5px solid #0B0F17;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.85);
  }

  .nav-cta-text-full {
    display: inline;
  }

  .nav-cta-text-short {
    display: none;
  }

  /* Mobile Quick WhatsApp Button */
  .mobile-quick-whatsapp {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: linear-gradient(180deg, #161E2E 0%, #0B0F17 100%);
    color: #25D366;
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-decoration: none;
    position: relative;
    box-shadow: 0 2px 8px rgba(11, 15, 23, 0.15);
    transition: transform 0.16s var(--ease-spring), background-color 0.18s ease;
  }

  .mobile-wa-status-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #10B981;
    border: 1.5px solid #0B0F17;
    box-shadow: 0 0 5px rgba(16, 185, 129, 0.8);
  }

  .mobile-quick-whatsapp:active {
    transform: scale(0.92);
  }

  /* Mobile Hamburger Toggle Button */
  .mobile-toggle-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(11, 15, 23, 0.04);
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0;
    color: var(--color-ink);
    transition: background-color 0.2s ease, transform 0.16s var(--ease-spring);
  }

  .mobile-toggle-btn:hover {
    background: rgba(11, 15, 23, 0.08);
  }

  .mobile-toggle-btn:active {
    transform: scale(0.92);
  }

  .hamburger-box {
    width: 18px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.24s var(--ease-out), opacity 0.24s ease;
  }

  /* Drawer Aesthetics */
  .mobile-drawer-inner {
    height: 100%;
    max-height: 100dvh;
    padding: 20px 18px 16px 18px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .drawer-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .drawer-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(11, 15, 23, 0.05);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-ink);
    transition: background-color 0.2s ease, transform 0.16s ease;
  }

  .drawer-close-btn:hover {
    background: rgba(11, 15, 23, 0.1);
  }

  .drawer-close-btn:active {
    transform: scale(0.92);
  }

  .drawer-coach-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .drawer-scroll-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-right: 4px;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.4) transparent;
  }

  .drawer-scroll-body::-webkit-scrollbar {
    width: 3px;
  }

  .drawer-scroll-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .drawer-scroll-body::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 9999px;
  }

  .drawer-group-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
    padding-left: 6px;
  }

  .drawer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 11px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 0.16s ease, transform 0.16s ease;
  }

  .drawer-link:hover, .drawer-link:active {
    background: #F8FAFC;
    transform: translateX(3px);
  }

  .drawer-link-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .preowned-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D9263E;
  }

  .drawer-badge-red {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #FFF1F2;
    color: #D9263E;
    border: 1px solid #FFE4E6;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .drawer-arrow {
    color: #94A3B8;
    font-size: 0.88rem;
    transition: transform 0.16s ease;
  }

  .drawer-link:hover .drawer-arrow {
    transform: translateX(3px);
    color: var(--color-ink);
  }

  .drawer-footer {
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    flex-shrink: 0;
  }

  .drawer-whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: #FFFFFF !important;
    border: 1px solid #047857;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 12px 18px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drawer-whatsapp-cta:hover {
    background: linear-gradient(135deg, #047857 0%, #065F46 100%);
    border-color: #065F46;
    box-shadow: 0 6px 18px rgba(5, 150, 105, 0.38);
    transform: translateY(-1px);
  }

  .drawer-whatsapp-cta:active {
    transform: scale(0.98);
  }

  .drawer-whatsapp-cta .wa-icon-svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
  }

  .drawer-guarantee-caption {
    font-size: 0.70rem;
    color: #94A3B8;
    text-align: center;
    margin-top: 8px;
    line-height: 1.4;
  }

  /* Responsive Calibration */
  /* Laptop & Mid-screen View (921px - 1180px) */
  @media (max-width: 1180px) and (min-width: 921px) {
    .site-nav-links {
      gap: 2px;
    }
    .site-nav-link {
      padding: 6px 8px;
      font-size: 0.80rem;
      gap: 4px;
    }
    .nav-verified-badge {
      font-size: 0.58rem;
      padding: 1px 3px;
    }
    .nav-cta-text-full {
      display: none;
    }
    .nav-cta-text-short {
      display: inline;
    }
    .nav-cta-whatsapp {
      padding: 7px 11px;
      font-size: 0.76rem;
    }
  }

  /* Mobile & Tablet View (<= 920px) */
  @media (max-width: 920px) {
    .site-nav {
      display: none !important;
    }
    .nav-cta-whatsapp {
      display: none !important;
    }
    .mobile-quick-whatsapp {
      display: inline-flex !important;
    }
    .mobile-toggle-btn {
      display: inline-flex !important;
    }
    .site-header-actions {
      gap: 8px;
    }
  }
</style>

<script>
  // Ensure header interactions run reliably across page loads and Astro view transitions
  function initHeader() {
    const header = document.getElementById('siteHeader');
    const menuBtn = document.getElementById('mobileMenuBtn');
    const closeBtn = document.getElementById('closeDrawerBtn');
    const backdrop = document.getElementById('drawerBackdrop');
    const drawer = document.getElementById('mobileDrawer');
    const drawerLinks = drawer?.querySelectorAll('a');

    // Dynamic scroll elevation listener
    const handleScroll = () => {
      if (window.scrollY > 15) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initial check

    // Mobile drawer toggling
    function openMenu() {
      drawer?.classList.add('open');
      backdrop?.classList.add('open');
      menuBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer?.classList.remove('open');
      backdrop?.classList.remove('open');
      menuBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    menuBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Close menu when any drawer link is clicked
    drawerLinks?.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('open')) {
        closeMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
