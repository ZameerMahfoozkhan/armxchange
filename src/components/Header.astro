---
import { CONTACT_INFO } from '../data/products';
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <div class="site-header-inner">
      <a href="/" aria-label="ArmXchange Homepage" style="display: flex; align-items: center;">
        <Logo variant="dark" size="md" />
      </a>

      <nav aria-label="Main Navigation">
        <ul class="site-nav-links">
          <li>
            <a href="/second-hand-weapons/" class={`site-nav-link highlight ${currentPath.includes('second-hand') ? 'active' : ''}`}>
              Pre-Owned
            </a>
          </li>
          <li>
            <a href="/new-weapons/" class={`site-nav-link ${currentPath.includes('new-weapons') ? 'active' : ''}`}>
              New Weapons
            </a>
          </li>
          <li>
            <a href="/accessories/" class={`site-nav-link ${currentPath.includes('accessories') ? 'active' : ''}`}>
              Accessories
            </a>
          </li>
          <li>
            <a href="/pellets/" class={`site-nav-link ${currentPath.includes('pellets') ? 'active' : ''}`}>
              Pellets
            </a>
          </li>
          <li>
            <a href="/how-it-works/" class={`site-nav-link ${currentPath.includes('how-it-works') ? 'active' : ''}`}>
              How It Works
            </a>
          </li>
          <li>
            <a href="/about-armxchange/" class={`site-nav-link ${currentPath.includes('about') ? 'active' : ''}`}>
              Founder
            </a>
          </li>
          <li>
            <a href="/contact/" class={`site-nav-link ${currentPath.includes('contact') ? 'active' : ''}`}>
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <div class="site-header-actions">
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about competition shooting sports equipment on ArmXchange.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary nav-whatsapp-btn"
          aria-label="Direct WhatsApp Consultation"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink: 0;">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="nav-whatsapp-label">Enquire on WhatsApp</span>
        </a>

        <button id="mobileMenuBtn" class="mobile-toggle" aria-label="Toggle Navigation Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav-whatsapp-btn {
    font-size: 0.82rem;
    padding: 9px 16px;
    white-space: nowrap;
  }
  @media (max-width: 540px) {
    .site-header-actions {
      gap: 8px;
    }
    .nav-whatsapp-btn {
      padding: 7px 10px;
      font-size: 0.78rem;
    }
    .nav-whatsapp-label {
      display: none;
    }
    .nav-whatsapp-btn::after {
      content: 'WhatsApp';
    }
  }
</style>

<!-- Mobile Navigation Drawer -->
<div id="mobileDrawer" class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div class="mobile-drawer-header">
    <a href="/" class="nav-brand">
      <Logo variant="dark" size="sm" />
    </a>
    <button id="closeDrawerBtn" class="mobile-toggle" aria-label="Close Navigation Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="mobile-drawer-links">
    <li><a href="/" class="mobile-drawer-link">Home</a></li>
    <li><a href="/second-hand-weapons/" class="mobile-drawer-link" style="color: var(--color-signal-red);">Second-Hand Weapons (Featured 2018 FWB 800)</a></li>
    <li><a href="/new-weapons/" class="mobile-drawer-link">New Competition Weapons</a></li>
    <li><a href="/accessories/" class="mobile-drawer-link">Shooting Accessories & Footwear</a></li>
    <li><a href="/pellets/" class="mobile-drawer-link">RWS Match Pellets</a></li>
    <li><a href="/how-it-works/" class="mobile-drawer-link">How ArmXchange Works</a></li>
    <li><a href="/pre-owned-equipment-guide/" class="mobile-drawer-link">Used Equipment Guide</a></li>
    <li><a href="/about-armxchange/" class="mobile-drawer-link">About Coach Pranatpal Singh</a></li>
    <li><a href="/contact/" class="mobile-drawer-link">Official Contact</a></li>
  </ul>

  <div style="margin-top: auto; padding-top: 24px;">
    <a 
      href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about shooting sports equipment on ArmXchange.')}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp-solid"
      style="width: 100%; justify-content: center; padding: 12px;"
    >
      <span>WhatsApp: {CONTACT_INFO.phoneDisplay}</span>
    </a>
  </div>
</div>

<script>
  const menuBtn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('closeDrawerBtn');
  const drawer = document.getElementById('mobileDrawer');

  function openMenu() {
    drawer?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer?.classList.remove('open');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
</script>
