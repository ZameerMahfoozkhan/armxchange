---
import { CONTACT_INFO } from '../data/products';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Active path helper
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/' || currentPath === '';
  const cleanPath = path.replace(/^\/|\/$/g, '');
  return currentPath.includes(cleanPath);
};
---

<header class="site-header" id="siteHeader">
  <div class="container header-container">
    <div class="site-header-inner">
      <!-- ArmXchange Brand Logo -->
      <a href="/" class="site-brand-link" aria-label="ArmXchange - Shooting Sports Marketplace Homepage">
        <Logo variant="dark" size="md" />
      </a>

      <!-- Desktop & Laptop Navigation Menu -->
      <nav class="site-nav" aria-label="Main Navigation">
        <ul class="site-nav-links">
          <!-- 1. Pre-Owned Dropdown -->
          <li class="nav-item-dropdown">
            <a 
              href="/second-hand-weapons/" 
              class={`site-nav-link nav-link-preowned ${isActive('/second-hand-weapons') ? 'active' : ''}`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="nav-pulse-dot" aria-hidden="true"></span>
              <span>Pre-Owned</span>
              <span class="nav-verified-badge">
                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Verified</span>
              </span>
              <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </a>

            <div class="nav-dropdown-menu" role="menu">
              <div class="dropdown-header-tag">VERIFIED PRE-OWNED HARDWARE</div>
              <div class="dropdown-links-list">
                <a href="/second-hand-weapons/?category=air-rifles" class="dropdown-item-card" role="menuitem">
                  <div class="dropdown-item-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="3" y1="12" x2="21" y2="12"></line>
                      <line x1="16" y1="8" x2="21" y2="12"></line>
                      <line x1="16" y1="16" x2="21" y2="12"></line>
                      <circle cx="9" cy="12" r="3"></circle>
                    </svg>
                  </div>
                  <div class="dropdown-item-text">
                    <div class="dropdown-item-title-row">
                      <span class="dropdown-item-title">10m Air Rifles</span>
                      <span class="dropdown-item-pill">Inspected</span>
                    </div>
                    <p class="dropdown-item-desc">Certified match air rifles with valid cylinder checks</p>
                  </div>
                </a>

                <a href="/second-hand-weapons/?category=air-pistols" class="dropdown-item-card" role="menuitem">
                  <div class="dropdown-item-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="5" y="8" width="14" height="5" rx="1"></rect>
                      <path d="M12 13v6a2 2 0 0 1-2 2H8"></path>
                      <circle cx="16" cy="10" r="1"></circle>
                    </svg>
                  </div>
                  <div class="dropdown-item-text">
                    <div class="dropdown-item-title-row">
                      <span class="dropdown-item-title">10m Air Pistols</span>
                      <span class="dropdown-item-pill">Concierge</span>
                    </div>
                    <p class="dropdown-item-desc">Olympic precision match pistols & athlete requests</p>
                  </div>
                </a>
              </div>

              <div class="dropdown-footer">
                <a href="/second-hand-weapons/" class="dropdown-footer-link">
                  <span>Browse All Pre-Owned Weapons</span>
                  <span class="dropdown-footer-arrow">→</span>
                </a>
              </div>
            </div>
          </li>

          <!-- 2. New Weapons Dropdown -->
          <li class="nav-item-dropdown">
            <a 
              href="/new-weapons/" 
