---
import type { Product } from '../data/products';
import { getWhatsAppListingUrl } from '../data/products';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  product: Product;
  class?: string;
}

const { product, class: className = '' } = Astro.props;
const whatsappUrl = getWhatsAppListingUrl(product.title, `https://armsxchange.in/listing/${product.slug}/`);
---

<article class={`product-card ${className}`.trim()}>
  <!-- Card Header Media Container with Dual-Bezel Pedestal -->
  <div class="product-media-wrap">
    <a href={`/listing/${product.slug}/`} class="product-image-box" aria-label={`View details for ${product.title}`}>
      <span class="product-crosshair-motif" aria-hidden="true"></span>
      <img 
        src={product.images[0]} 
        alt={`${product.brand} ${product.title} - ${product.categoryLabel || 'Competition Target Shooting'}`}
        width="300"
        height="170"
        loading="lazy"
        decoding="async"
      />
    </a>

    <!-- Top Floating Status Badges -->
    <div class="product-badges-float">
      {product.isPreOwned ? (
        <span class="product-badge product-badge-preowned">
          <span class="badge-pulse-dot" aria-hidden="true"></span>
          <span>Verified Pre-Owned</span>
        </span>
      ) : (
        <span class="product-badge product-badge-new">
          <svg class="badge-shield-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Brand New</span>
        </span>
      )}
    </div>
  </div>

  <div class="product-content">
    <div class="product-meta-row">
      <span class="product-brand">{product.brand}</span>
      <span class="product-meta-divider">//</span>
      <span class="product-discipline-tag">{product.category === 'pellets' ? '.177 Match' : product.category === 'accessories' ? 'Precision Gear' : product.subcategory === 'air-pistols' ? '10m Air Pistol' : '10m Air Rifle'}</span>
    </div>
    
    <h3 class="product-title">
      <a href={`/listing/${product.slug}/`}>{product.title}</a>
    </h3>

    <p class="product-desc">{product.shortDescription}</p>

    <!-- Technical Spec Pills -->
    <div class="product-spec-pills">
      <span class="spec-pill spec-pill-primary">
        {product.conditionGrade}
      </span>
      {product.specifications["Calibre"] && (
        <span class="spec-pill">
          .177 Cal
        </span>
      )}
      {product.specifications["Cylinder Validity"] && (
        <span class="spec-pill spec-pill-highlight">
          {product.specifications["Cylinder Validity"].match(/20\d{2}/g)?.slice(-1)[0] ? `Cylinder to ${product.specifications["Cylinder Validity"].match(/20\d{2}/g)?.slice(-1)[0]}` : 'Cylinder Inspected'}
        </span>
      )}
    </div>

    <!-- Pricing & High-End Action Footer -->
    <div class="product-footer">
      <div class="product-pricing-block">
        {product.priceDisplay.toLowerCase().includes('enquire') ? (
          <div>
            <div class="price-enquiry-label">{product.isPreOwned ? 'Valuation' : 'Pricing'}</div>
            <div class="product-price-enquiry">On Request</div>
          </div>
        ) : (
          <div>
            <div class="price-retail-label">Athletic Price</div>
            <div class="product-price">{product.priceDisplay}</div>
            {product.category === 'new-weapons' && product.taxNote && (
              <div class="product-tax-note">+18% GST (Non-Renowned)</div>
            )}
          </div>
        )}
      </div>

      <div class="product-card-actions">
        <a 
          href={`/listing/${product.slug}/`}
          class="card-btn-details"
          aria-label={`View details for ${product.title}`}
        >
          <span>Details</span>
          <span class="btn-arrow-circle" aria-hidden="true">→</span>
        </a>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-btn-enquire"
          title="Direct WhatsApp Consultation"
          aria-label={`Enquire on WhatsApp for ${product.title}`}
        >
          <WhatsAppIcon size={14} />
          <span>Enquire</span>
        </a>
      </div>
    </div>
  </div>
</article>


