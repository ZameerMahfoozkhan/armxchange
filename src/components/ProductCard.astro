---
import type { Product } from '../data/products';
import { getWhatsAppListingUrl } from '../data/products';

interface Props {
  product: Product;
  class?: string;
}

const { product, class: className = '' } = Astro.props;
const whatsappUrl = getWhatsAppListingUrl(product.title, `https://armxchange.in/listing/${product.slug}/`);
---

<article class={`product-card ${className}`.trim()}>
  <a href={`/listing/${product.slug}/`} class="product-image-box" aria-label={`View details for ${product.title}`}>
    <img 
      src={product.images[0]} 
      alt={`${product.brand} ${product.title} - ${product.categoryLabel || 'Competition Target Shooting'}`}
      width="300"
      height="170"
      loading="lazy"
      decoding="async"
    />
    <div style="position: absolute; top: 10px; left: 10px; display: flex; gap: 6px;">
      {product.isPreOwned ? (
        <span class="tech-badge tech-badge-preowned">Pre-Owned</span>
      ) : (
        <span class="tech-badge tech-badge-new">Brand New</span>
      )}
    </div>
  </a>

  <div class="product-content">
    <div class="product-brand">{product.brand}</div>
    
    <h3 class="product-title">
      <a href={`/listing/${product.slug}/`}>{product.title}</a>
    </h3>

    <p class="product-desc">{product.shortDescription}</p>

    <!-- Technical tags -->
    <div style="margin-bottom: 10px; display: flex; flex-wrap: wrap; gap: 5px;">
      <span class="tech-badge">
        {product.conditionGrade}
      </span>
      {product.specifications["Calibre"] && (
        <span class="tech-badge">
          .177 Cal
        </span>
      )}
      {product.specifications["Cylinder Validity"] && (
        <span class="tech-badge tech-badge-new">
          Cylinder to 2034
        </span>
      )}
    </div>

    <div class="product-footer">
      <div>
        {product.priceDisplay === 'Price on Enquiry' ? (
          <span class="product-price-enquiry">Price on Enquiry</span>
        ) : (
          <div>
            <div class="product-price">{product.priceDisplay}</div>
            {product.category === 'new-weapons' && product.taxNote && (
              <div style="font-size: 0.68rem; color: var(--color-text-light); line-height: 1.2;">+18% GST (Non-Renowned)</div>
            )}
          </div>
        )}
      </div>

      <div class="product-card-actions">
        <a 
          href={`/listing/${product.slug}/`}
          class="btn btn-secondary card-btn-details"
          aria-label={`View details for ${product.title}`}
        >
          <span>Details</span>
          <span class="btn-trailing-icon" style="width: 16px; height: 16px; font-size: 0.7rem; margin-left: 2px;">→</span>
        </a>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp-solid card-btn-enquire"
          title="Direct WhatsApp Consultation"
          aria-label={`Enquire on WhatsApp for ${product.title}`}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
          </svg>
          <span>Enquire</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card-actions {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .card-btn-details, .card-btn-enquire {
    padding: 7px 11px;
    font-size: 0.78rem;
    gap: 4px;
  }
  @media (max-width: 640px) {
    .product-card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      width: 100%;
    }
    .card-btn-details, .card-btn-enquire {
      padding: 6px 4px !important;
      font-size: 0.70rem !important;
      justify-content: center;
    }
  }
</style>
