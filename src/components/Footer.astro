---
import { CONTACT_INFO } from '../data/products';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Mission -->
      <div>
        <a href="/" aria-label="ArmsXchange Home" style="display: inline-block; margin-bottom: 20px;">
          <Logo variant="light" size="lg" />
        </a>
        <p style="font-size: 0.9rem; line-height: 1.65; color: #94A3B8; margin-bottom: 20px;">
          <strong>ArmsXchange</strong> is India’s specialized platform for competition shooting sports equipment. Founded by national-level shooter <strong>Pranatpal Singh</strong> (who recently started his coaching journey over the past year), our objective is to make equipment discovery authentic, verified, and accessible to every dedicated athlete.
        </p>
        <div>
          <span class="tech-badge" style="background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.12); color: #E2E8F0;">
            {CONTACT_INFO.brandMotto}
          </span>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="footer-heading">Equipment</h3>
        <ul class="footer-links">
          <li class="footer-link"><a href="/second-hand-weapons/">Second-Hand Weapons</a></li>
          <li class="footer-link"><a href="/second-hand-air-rifles/">Pre-Owned 10m Rifles</a></li>
          <li class="footer-link"><a href="/second-hand-air-pistols/">Pre-Owned 10m Pistols</a></li>
          <li class="footer-link"><a href="/10m-air-rifles/">New 10m Match Rifles</a></li>
          <li class="footer-link"><a href="/10m-air-pistols/">New 10m Match Pistols</a></li>
          <li class="footer-link"><a href="/shooting-boots/">Match Boots & Shoes</a></li>
          <li class="footer-link"><a href="/accessories/">Shooting Accessories</a></li>
          <li class="footer-link"><a href="/pellets/">RWS Match Pellets</a></li>
        </ul>
      </div>

      <!-- Guide & Resources -->
      <div>
        <h3 class="footer-heading">Information</h3>
        <ul class="footer-links">
          <li class="footer-link"><a href="/how-it-works/">How ArmsXchange Works</a></li>
          <li class="footer-link"><a href="/about-armsxchange/">Our Story & Founder</a></li>
          <li class="footer-link"><a href="/blog/">Journal & Guides</a></li>
          <li class="footer-link"><a href="/pre-owned-equipment-guide/">Used Equipment Guide</a></li>
          <li class="footer-link"><a href="/contact/">Official Contact</a></li>
          <li class="footer-link"><a href="/legal/eligibility/">Shooter Eligibility & GST</a></li>
          <li class="footer-link"><a href="/legal/terms/">Terms of Service</a></li>
          <li class="footer-link"><a href="/legal/privacy/">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Direct Contact -->
      <div>
        <h3 class="footer-heading">Direct Enquiries</h3>
        <p style="font-size: 0.88rem; margin-bottom: 16px; color: #94A3B8; line-height: 1.55;">
          Official WhatsApp orders, equipment verification, and athlete telephone consultation:
        </p>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
          <a 
            href={`https://wa.me/${CONTACT_INFO.whatsappPhoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to place an order / enquire about shooting sports equipment on ArmsXchange.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp-solid"
            style="justify-content: space-between; padding: 11px 16px; font-size: 0.88rem; width: 100%; border-radius: 8px;"
          >
            <span style="display: inline-flex; align-items: center; gap: 9px;">
              <WhatsAppIcon size={18} />
              <span>WhatsApp Orders & Concierge</span>
            </span>
            <span class="btn-trailing-icon">→</span>
          </a>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <a 
              href={`tel:${CONTACT_INFO.whatsappPhoneRaw}`}
              class="btn btn-secondary"
              style="justify-content: center; background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); color: #FFFFFF; padding: 9px 10px; font-size: 0.8rem; border-radius: 8px; text-align: center;"
              title="Call WhatsApp & Orders Line"
            >
              <span>Call Orders Line</span>
            </a>
            <a 
              href={`tel:${CONTACT_INFO.secondaryPhoneRaw}`}
              class="btn btn-secondary"
              style="justify-content: center; background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); color: #FFFFFF; padding: 9px 10px; font-size: 0.8rem; border-radius: 8px; text-align: center;"
              title="Call Founder Direct Line"
            >
              <span>Call Founder Line</span>
            </a>
          </div>
        </div>
        <div style="font-size: 0.76rem; color: #94A3B8; font-family: var(--font-mono); line-height: 1.6;">
          <div><strong style="color: #CBD5E1;">WhatsApp & Orders:</strong> {CONTACT_INFO.whatsappPhoneDisplay}</div>
          <div><strong style="color: #CBD5E1;">Direct Support:</strong> {CONTACT_INFO.secondaryPhoneDisplay}</div>
          <div style="color: #64748B; margin-top: 3px;">Mon - Sat 9:00 AM - 7:00 PM IST</div>
        </div>
      </div>
    </div>

    <!-- Legal Compliance -->
    <div class="footer-disclaimer">
      <strong style="color: #E2E8F0; display: block; margin-bottom: 4px; font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.04em;">
        LEGAL & COMPLIANCE (INDIAN ARMS RULES 2016 / 0.177 CALIBRE):
      </strong>
      ArmsXchange is an equipment discovery and athlete consultation platform. All featured air weapons are strictly competition-grade 0.177 calibre (4.5 mm) target pneumatics generating under 20 Joules of muzzle energy in accordance with Schedule I, Category III(f) of the Arms Rules 2016 (MHA, Government of India). We do not list, facilitate, or transfer cartridge firearms or restricted arms. An additional 18% GST applies for non-renowned shooters on brand-new imported weapons per prevailing Indian customs schedules. Shooter credential verification (NRAI / State Rifle Association) is conducted prior to equipment transfer.
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} ArmsXchange. All rights reserved.</p>
      <p class="footer-credit">
        Designed &amp; Developed with <span class="footer-heart" aria-label="love">❤️</span> by <a href="https://zameerkhan.online" target="_blank" rel="noopener noreferrer">Zameer</a> · Powered by <a href="https://zamify.online" target="_blank" rel="noopener noreferrer">Zamify</a>
      </p>
      <p style="font-family: var(--font-mono); font-size: 0.76rem;">Precision 10m Competition Equipment</p>
    </div>
  </div>
</footer>
