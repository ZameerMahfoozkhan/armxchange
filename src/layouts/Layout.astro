---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "ArmXchange | India's Shooting Sports Equipment Marketplace",
  description = "ArmXchange connects Indian shooting athletes with approved pre-owned and new 10m air rifles, match air pistols, competition footwear, and precision accessories. Founded by national shooter Pranatpal Singh.",
  image = "/images/brand/armxchange-logo.webp",
  type = "website"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://armxchange.in";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const resolvedImage = image || "/images/brand/armxchange-logo.webp";
const ogImageUrl = resolvedImage.startsWith('http') 
  ? resolvedImage 
  : new URL(resolvedImage, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons & Touch Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="ArmXchange" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ArmXchange",
      "url": siteUrl,
      "logo": new URL("/images/brand/armxchange-logo.webp", siteUrl).toString(),
      "description": "India's dedicated platform for approved competition shooting sports equipment, pre-owned 10m match air rifles, match air pistols, accessories, and match pellets.",
      "founder": {
        "@type": "Person",
        "name": "Pranatpal Singh",
        "jobTitle": "National-Level 10m Air Rifle Shooter & Coach"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-6392421574",
        "contactType": "Customer Support & Equipment Consultations",
        "areaServed": "IN"
      }
    })} />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
