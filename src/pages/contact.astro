---
import Layout from '../layouts/Layout.astro';
import { CONTACT_INFO } from '../data/products';
---

<Layout
  title="Contact ArmXchange | Official Consultation & WhatsApp Enquiries"
  description="Connect directly with founder and national shooter Pranatpal Singh at +91 6392421574 for shooting sports equipment consultation, pre-owned listings, and match inquiries."
>
  <div class="container" style="padding-top: 28px; padding-bottom: 88px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--color-ink); font-weight: 500;">Home</a> 
      <span style="color: #CBD5E1; font-size: 0.75rem;">/</span>
      <span style="color: var(--color-text-muted);">Contact</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 48px; max-width: 860px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
        <span class="tech-badge">DIRECT ATHLETE COMMUNICATION</span>
        <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">
          ATHLETE CONCIERGE LINE
        </span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin-bottom: 18px; color: var(--color-ink); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;">
        Official Equipment Consultations & Enquiries
      </h1>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-body);">
        Have technical questions regarding specific competition air rifles, trigger assemblies, anatomical grip sizing, or cylinder manufacturing stamps? We handle all athlete consultations directly through WhatsApp and phone.
      </p>
    </div>

    <!-- Contact Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 64px;" class="contact-grid">
      <!-- Direct Contact Channels -->
      <div>
        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 32px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
            <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--color-whatsapp); display: flex; align-items: center; justify-content: center; color: #FFFFFF; flex-shrink: 0;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
            </div>
            <div>
              <div style="color: var(--color-ink); font-size: 1.1rem; font-weight: 700;">Direct WhatsApp Concierge</div>
              <span style="font-size: 0.8rem; color: var(--color-text-muted); font-family: var(--font-mono);">PRIMARY FAST-RESPONSE ROUTE</span>
            </div>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-body); margin-bottom: 20px; line-height: 1.6;">
            Direct discussion with founder and national shooter Pranatpal Singh (who has also been coaching for the past year). Share your current equipment setup, discuss grip sizes, or request test group sheets.
          </p>
          <a 
            href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about shooting sports equipment on ArmXchange.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp-solid"
            style="width: 100%; justify-content: center; font-size: 0.95rem; padding: 12px 20px;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            <span>Message on WhatsApp ({CONTACT_INFO.phoneDisplay})</span>
          </a>
        </div>

        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 32px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
            <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--color-canvas-subtle); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; color: var(--color-ink); flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <div style="color: var(--color-ink); font-size: 1.1rem; font-weight: 700;">Direct Phone Consultation</div>
              <span style="font-size: 0.8rem; color: var(--color-text-muted); font-family: var(--font-mono);">MON - SAT 09:00 - 19:00 IST</span>
            </div>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-body); margin-bottom: 20px; line-height: 1.6;">
            Speak directly with our team for technical comparisons, academy carton orders, and consignment evaluations.
          </p>
          <a 
            href={`tel:${CONTACT_INFO.phone}`}
            class="btn btn-secondary"
            style="width: 100%; justify-content: center; font-size: 0.95rem; padding: 12px 20px;"
          >
            <span>Call: {CONTACT_INFO.phoneDisplay}</span>
          </a>
        </div>

        <div style="background: var(--color-canvas-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 20px;">
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; color: var(--color-ink); text-transform: uppercase; margin-bottom: 6px;">
            Range Visitation Protocol:
          </div>
          <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.6;">
            ArmXchange operates on an appointment-first basis. All match rifle test firings, dry-fire inspections, and face-to-face evaluations are coordinated through our verified shooting range partners across India.
          </p>
        </div>
      </div>

      <!-- Quick Consultation Form (Client-Side WhatsApp Generator) -->
      <div>
        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 36px 32px; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="tech-badge">INSTANT CONCIERGE</span>
          </div>
          <h2 style="font-size: 1.45rem; margin-bottom: 8px; color: var(--color-ink); font-weight: 700;">
            Equipment Consultation Request
          </h2>
          <p style="font-size: 0.86rem; color: var(--color-text-muted); margin-bottom: 24px; line-height: 1.6;">
            Select your discipline requirements below to generate an exact inquiry message to Pranatpal Singh on WhatsApp.
          </p>

          <form id="consultForm" style="display: flex; flex-direction: column; gap: 18px;">
            <div>
              <label for="shooterName" style="display: block; font-size: 0.74rem; font-family: var(--font-mono); color: var(--color-text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                Shooter / Athlete Full Name:
              </label>
              <input 
                type="text" 
                id="shooterName" 
                required 
                placeholder="e.g. Rahul Sharma"
                style="width: 100%; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 10px 14px; color: var(--color-ink); font-family: var(--font-sans); outline: none; font-size: 0.9rem;"
              />
            </div>

            <div>
              <label for="interestCategory" style="display: block; font-size: 0.74rem; font-family: var(--font-mono); color: var(--color-text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                Equipment Interest:
              </label>
              <select 
                id="interestCategory" 
                style="width: 100%; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 10px 14px; color: var(--color-ink); font-family: var(--font-sans); outline: none; font-size: 0.9rem; cursor: pointer;"
              >
                <option value="Pre-Owned 2018 Feinwerkbau 800 Alu (2024 Cylinder)">Pre-Owned 2018 Feinwerkbau 800 Alu (2024 Cylinder)</option>
                <option value="New Walther LG500 itec Series">New Walther LG500 itec Series (Electronic/Mechanical)</option>
                <option value="New Feinwerkbau 900 Alu">New Feinwerkbau 900 Alu</option>
                <option value="Olympic Match Air Pistol (Morini/Steyr)">Olympic Match Air Pistol (Morini / Steyr)</option>
                <option value="MEC Sights & Shooting Footwear">MEC Sights & Shooting Footwear</option>
                <option value="RWS R10 Match Pellets">RWS R10 Match Pellets</option>
                <option value="Consigning My Pre-Owned Weapon">Consigning My Pre-Owned Weapon</option>
              </select>
            </div>

            <div>
              <label for="shooterLevel" style="display: block; font-size: 0.74rem; font-family: var(--font-mono); color: var(--color-text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                Shooter Classification:
              </label>
              <select 
                id="shooterLevel" 
                style="width: 100%; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 10px 14px; color: var(--color-ink); font-family: var(--font-sans); outline: none; font-size: 0.9rem; cursor: pointer;"
              >
                <option value="Junior / Beginner Athlete">Junior / Beginner Athlete</option>
                <option value="National / Renowned Shooter (NRAI)">National / Renowned Shooter (NRAI)</option>
                <option value="Shooting Academy / Coach">Shooting Academy / Coach</option>
                <option value="Club Member">Club Member</option>
              </select>
            </div>

            <div>
              <label for="consultMessage" style="display: block; font-size: 0.74rem; font-family: var(--font-mono); color: var(--color-text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em;">
                Specific Technical Question / Grip Dimensions:
              </label>
              <textarea 
                id="consultMessage" 
                rows="3" 
                placeholder="e.g. Inquiring about right-hand medium grip fit, cylinder validity, or scheduling inspection..."
                style="width: 100%; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 10px 14px; color: var(--color-ink); font-family: var(--font-sans); outline: none; resize: vertical; font-size: 0.9rem;"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="btn btn-whatsapp-solid" 
              style="width: 100%; justify-content: center; font-size: 0.95rem; padding: 13px; margin-top: 6px;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
              <span>Transmit Consultation to WhatsApp</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 868px) {
    .contact-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
  }
  @media (max-width: 600px) {
    .contact-grid > div > div {
      padding: 20px 16px !important;
    }
    .contact-grid .btn {
      white-space: normal !important;
      font-size: 0.9rem !important;
      padding: 12px 14px !important;
    }
  }
</style>

<script>
  import { CONTACT_INFO } from '../data/products';

  const form = document.getElementById('consultForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('shooterName') as HTMLInputElement).value;
    const item = (document.getElementById('interestCategory') as HTMLSelectElement).value;
    const level = (document.getElementById('shooterLevel') as HTMLSelectElement).value;
    const msg = (document.getElementById('consultMessage') as HTMLTextAreaElement).value;

    const fullText = `Hi Pranatpal, my name is ${name} (${level}). I am enquiring on ArmXchange regarding: ${item}.\nDetails: ${msg || 'Please share availability and next steps.'}`;
    const url = `https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent(fullText)}`;
    window.open(url, '_blank');
  });
</script>
