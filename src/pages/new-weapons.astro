---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS } from '../data/products';

const newWeapons = PRODUCTS.filter(p => p.category === 'new-weapons');
---

<Layout
  title="New Olympic Match Air Rifles & Pistols | ArmXchange"
  description="Brand-new competition air rifles and pistols from Walther, Feinwerkbau, Steyr, and Morini. Electronic and mechanical triggers with full GST transparency."
>
  <div class="container" style="padding-top: 28px; padding-bottom: 88px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--color-ink); font-weight: 500;">Home</a> 
      <span style="color: #CBD5E1; font-size: 0.75rem;">/</span>
      <span style="color: var(--color-text-muted);">New Weapons</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 40px; max-width: 860px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
        <span class="tech-badge tech-badge-new">FACTORY DIRECT IMPORTS</span>
        <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">
          OLYMPIC 10M DISCIPLINE
        </span>
      </div>
      <h1 style="margin-bottom: 16px; font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 800; color: var(--color-ink); letter-spacing: -0.03em;">
        New Competition Match Weapons
      </h1>
      <p style="font-size: 1.05rem; line-height: 1.65; color: var(--color-text-body);">
        Explore brand-new Olympic 10m target rifles and air pistols engineered by the world’s foremost sporting manufacturers: Walther, Feinwerkbau, Steyr, and Morini. Featuring precision electronic triggers, ultra-crisp mechanical units, and full NRAI certification support.
      </p>
    </div>

    <!-- GST Information Banner -->
    <div class="reveal-on-scroll" style="background: var(--color-canvas-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 18px 24px; margin-bottom: 36px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div style="display: flex; align-items: center; gap: 14px;">
        <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: #FFFFFF; border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; color: var(--color-ink); flex-shrink: 0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </div>
        <div>
          <div style="font-size: 0.88rem; font-weight: 700; color: var(--color-ink);">
            Renowned Shooter GST Information
          </div>
          <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-top: 2px;">
            Prices shown are base import figures. Under Indian Customs & GST regulations, an additional 18% GST applies for non-renowned shooters (athletes without an official NRAI certificate).
          </p>
        </div>
      </div>
      <a href="/legal/eligibility/" class="btn btn-secondary" style="padding: 7px 14px; font-size: 0.78rem; font-family: var(--font-mono); white-space: nowrap;">
        <span>ELIGIBILITY GUIDE</span>
        <span class="btn-trailing-icon">→</span>
      </a>
    </div>

    <!-- Filter Buttons & Controls -->
    <div style="margin-bottom: 28px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
      <div id="filterButtonGroup" style="display: flex; flex-wrap: wrap; gap: 8px;">
        <button class="filter-chip active" data-filter="all">ALL WEAPONS ({newWeapons.length})</button>
        <button class="filter-chip" data-filter="air-rifles">10M AIR RIFLES ({newWeapons.filter(p => p.subcategory === 'air-rifles').length})</button>
        <button class="filter-chip" data-filter="air-pistols">10M AIR PISTOLS ({newWeapons.filter(p => p.subcategory === 'air-pistols').length})</button>
      </div>

      <div style="display: flex; gap: 8px; align-items: center;">
        <label for="brandSelect" style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase;">
          Brand:
        </label>
        <select id="brandSelect" style="background: #FFFFFF; color: var(--color-ink); border: 1px solid var(--color-border); padding: 7px 12px; border-radius: var(--radius-sm); font-size: 0.82rem; font-family: var(--font-mono); outline: none; font-weight: 600; cursor: pointer;">
          <option value="all">ALL BRANDS</option>
          <option value="Walther">WALTHER</option>
          <option value="Feinwerkbau">FEINWERKBAU</option>
          <option value="Steyr">STEYR</option>
          <option value="Morini">MORINI</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div id="weaponGrid" class="product-grid">
      {newWeapons.map((product, idx) => (
        <div class="weapon-item" data-sub={product.subcategory} data-brand={product.brand}>
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        </div>
      ))}
    </div>

    <div id="noResults" style="display: none; text-align: center; padding: 60px 20px;">
      <p style="font-size: 1.05rem; color: var(--color-text-body); margin-bottom: 14px;">No match weapons found matching this criterion.</p>
      <button id="resetFilters" class="btn btn-secondary">Reset Filters</button>
    </div>
  </div>
</Layout>

<style>
  .filter-chip {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
    padding: 7px 15px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: transform var(--transition-spring), background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow var(--transition-smooth);
    will-change: transform;
  }

  .filter-chip:hover {
    border-color: var(--color-ink);
    transform: translateY(-1px);
  }

  .filter-chip:active {
    transform: scale(0.96) !important;
  }

  .filter-chip.active {
    background: var(--color-ink);
    color: #FFFFFF;
    border-color: var(--color-ink);
    box-shadow: 0 2px 8px rgba(11, 15, 23, 0.18);
  }

  .weapon-item {
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out-expo);
  }
</style>

<script>
  const filterChips = document.querySelectorAll('.filter-chip');
  const brandSelect = document.getElementById('brandSelect') as HTMLSelectElement;
  const items = document.querySelectorAll('.weapon-item');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('resetFilters');

  let activeSub = 'all';
  let activeBrand = 'all';

  function applyFilters() {
    let visibleCount = 0;
    items.forEach(el => {
      const itemEl = el as HTMLElement;
      const sub = itemEl.dataset.sub;
      const brand = itemEl.dataset.brand;

      const matchesSub = (activeSub === 'all' || sub === activeSub);
      const matchesBrand = (activeBrand === 'all' || brand === activeBrand);

      if (matchesSub && matchesBrand) {
        itemEl.style.display = 'block';
        visibleCount++;
      } else {
        itemEl.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterChips.forEach(btn => {
    btn.addEventListener('click', () => {
      filterChips.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeSub = (btn as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });

  brandSelect?.addEventListener('change', () => {
    activeBrand = brandSelect.value;
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    activeSub = 'all';
    activeBrand = 'all';
    if (brandSelect) brandSelect.value = 'all';
    filterChips.forEach(b => {
      if ((b as HTMLElement).dataset.filter === 'all') {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    });
    applyFilters();
  });
</script>
