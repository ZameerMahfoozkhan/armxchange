---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { CONTACT_INFO } from '../data/products';
---

<Layout
  title="How ArmXchange Works | Equipment Consultation & Verification"
  description="Understand the step-by-step buyer and seller workflow on ArmXchange. Transparent condition disclosures, shooter consultations, and lawful transfer procedures."
>
  <div class="container" style="padding-top: 28px; padding-bottom: 88px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--color-ink); font-weight: 500;">Home</a> 
      <span style="color: #CBD5E1; font-size: 0.75rem;">/</span>
      <span style="color: var(--color-text-muted);">How It Works</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 48px; max-width: 860px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
        <span class="tech-badge">PLATFORM OPERATING MODEL</span>
        <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">
          ATHLETE-GUIDED WORKFLOW
        </span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin-bottom: 18px; color: var(--color-ink); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;">
        How ArmXchange Works: The Direct Concierge Protocol
      </h1>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-body);">
        Unlike generic classifieds or unmoderated peer-to-peer forums, ArmXchange is an accountable, shooter-guided consultation platform. We deliberately reject automated shopping carts and anonymous checkout flows for precision match instruments.
      </p>
    </div>

    <!-- For Buyers Flow -->
    <div style="margin-bottom: 64px;">
      <div style="margin-bottom: 24px;">
        <span class="tech-badge" style="margin-bottom: 8px;">ACQUISITION PROTOCOL</span>
        <h2 style="font-size: 1.6rem; color: var(--color-ink); font-weight: 800; margin-top: 4px;">
          1. The Athlete Equipment Journey
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 20px;">
        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px;">
          <div style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.08em; margin-bottom: 12px;">
            PHASE 01 //
          </div>
          <h3 style="font-size: 1.12rem; margin-bottom: 8px; color: var(--color-ink); font-weight: 700;">
            Inspect Verified Listings
          </h3>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body);">
            Browse our catalogue of pre-owned 10m air rifles (including verified serial numbers and cylinder expiration years), brand-new Olympic weapons, MEC match sights, and RWS pellets.
          </p>
        </div>

        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px;">
          <div style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.08em; margin-bottom: 12px;">
            PHASE 02 //
          </div>
          <h3 style="font-size: 1.12rem; margin-bottom: 8px; color: var(--color-ink); font-weight: 700;">
            Review Technical Disclosures
          </h3>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body);">
            Examine written hardware condition reports, cylinder test validity (ISSF 10-year rule), included travel cases, diopter sights, and applicable GST terms (18% on new weapons for non-renowned shooters).
          </p>
        </div>

        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px;">
          <div style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.08em; margin-bottom: 12px;">
            PHASE 03 //
          </div>
          <h3 style="font-size: 1.12rem; margin-bottom: 8px; color: var(--color-ink); font-weight: 700;">
            Direct WhatsApp Consultation
          </h3>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body);">
            Click "Enquire on WhatsApp" to open a direct discussion with founder and national shooter Pranatpal Singh with the listing context attached. Ask about barrel harmonics, grip fit, or request test card sheets.
          </p>
        </div>

        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px;">
          <div style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.08em; margin-bottom: 12px;">
            PHASE 04 //
          </div>
          <h3 style="font-size: 1.12rem; margin-bottom: 8px; color: var(--color-ink); font-weight: 700;">
            Verification & Handover
          </h3>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body);">
            We verify shooting athlete credentials (NRAI Shooter ID / club affiliation where applicable) and coordinate safe in-person collection or fully insured courier delivery.
          </p>
        </div>
      </div>
    </div>

    <!-- For Sellers Flow -->
    <div style="margin-bottom: 64px;">
      <div style="margin-bottom: 24px;">
        <span class="tech-badge" style="margin-bottom: 8px;">CONSIGNMENT PROTOCOL</span>
        <h2 style="font-size: 1.6rem; color: var(--color-ink); font-weight: 800; margin-top: 4px;">
          2. Consigning Your Match Equipment
        </h2>
      </div>

      <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 36px 32px; box-shadow: var(--shadow-sm);">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #475569; font-weight: 700; margin-bottom: 8px;">STEP 01</div>
            <h3 style="font-size: 1.05rem; color: var(--color-ink); margin-bottom: 6px; font-weight: 700;">Submit Hardware Specs</h3>
            <p style="font-size: 0.86rem; color: var(--color-text-body); line-height: 1.6;">
              Message national shooter Pranatpal Singh with your rifle/pistol brand, model, cylinder manufacturing year, included accessories, and notes on use.
            </p>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #475569; font-weight: 700; margin-bottom: 8px;">STEP 02</div>
            <h3 style="font-size: 1.05rem; color: var(--color-ink); margin-bottom: 6px; font-weight: 700;">Physical Verification</h3>
            <p style="font-size: 0.86rem; color: var(--color-text-body); line-height: 1.6;">
              We examine cylinder safety stamps, review high-res photographs of contact surfaces, and evaluate regulator performance.
            </p>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #475569; font-weight: 700; margin-bottom: 8px;">STEP 03</div>
            <h3 style="font-size: 1.05rem; color: var(--color-ink); margin-bottom: 6px; font-weight: 700;">Dossier Publication</h3>
            <p style="font-size: 0.86rem; color: var(--color-text-body); line-height: 1.6;">
              Once approved, your equipment is listed with authentic photos, accurate specifications, and clear condition disclosures.
            </p>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #475569; font-weight: 700; margin-bottom: 8px;">STEP 04</div>
            <h3 style="font-size: 1.05rem; color: var(--color-ink); margin-bottom: 6px; font-weight: 700;">Athlete Matching</h3>
            <p style="font-size: 0.86rem; color: var(--color-text-body); line-height: 1.6;">
              We connect you with serious, vetted competitive shooters across India, ensuring an honest and compliant equipment handover.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Transparency Matrix -->
    <div style="margin-bottom: 64px;">
      <div style="margin-bottom: 24px;">
        <span class="tech-badge" style="margin-bottom: 8px;">STANDARDS MATRIX</span>
        <h2 style="font-size: 1.6rem; color: var(--color-ink); font-weight: 800; margin-top: 4px;">
          Platform Verification Matrix
        </h2>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;" class="matrix-grid">
        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 32px;">
          <h3 style="color: var(--color-ink); margin-bottom: 16px; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-signal-green);">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>What ArmXchange Explicitly Verifies:</span>
          </h3>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 0.88rem; color: var(--color-text-body);">
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-signal-green); flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Cylinder Timestamps:</strong> Explicit validation against ISSF 10-year expiration standards.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-signal-green); flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Authentic Macro Photography:</strong> True item photos documenting actual condition, never deceptive stock renders.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-signal-green); flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Mechanical Completeness:</strong> Confirming diopters, iris apertures, buttplates, and accessories match specifications.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-signal-green); flex-shrink: 0; margin-top: 2px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span><strong>Kinetic Energy & Calibre:</strong> Validating equipment is strictly 0.177 cal &lt; 20 Joules under Arms Rules 2016 Category III(f).</span>
            </li>
          </ul>
        </div>

        <div style="background: var(--color-canvas-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 32px;">
          <h3 style="color: var(--color-ink); margin-bottom: 16px; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-text-muted);">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>What Athletes Should Keep in Mind:</span>
          </h3>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 0.88rem; color: var(--color-text-body);">
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--color-text-muted); font-weight: 700; flex-shrink: 0;">&bull;</span>
              <span><strong>No Impersonal E-Commerce:</strong> We conduct zero unvetted checkouts. Every acquisition involves direct consultation.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--color-text-muted); font-weight: 700; flex-shrink: 0;">&bull;</span>
              <span><strong>Anatomical Sizing:</strong> Shooters must verify grip dimension (S/M/L, Right/Left) with our team before closing.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--color-text-muted); font-weight: 700; flex-shrink: 0;">&bull;</span>
              <span><strong>Lawful Sporting Conduct:</strong> Handover protocols adhere strictly to Indian sporting target norms.</span>
            </li>
            <li style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="color: var(--color-text-muted); font-weight: 700; flex-shrink: 0;">&bull;</span>
              <span><strong>GST Clarity:</strong> An additional 18% GST applies to non-renowned shooters on new weapons per statutory regulations.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 48px 32px; text-align: center; box-shadow: var(--shadow-sm);">
      <div style="max-width: 580px; margin: 0 auto;">
        <span class="tech-badge" style="margin-bottom: 14px;">CONSULTATION READY</span>
        <h2 style="font-size: clamp(1.6rem, 2.8vw, 2.1rem); margin-bottom: 12px; color: var(--color-ink); font-weight: 800;">
          Ready to Consult on Competition Gear?
        </h2>
        <p style="margin-bottom: 28px; font-size: 0.95rem; color: var(--color-text-body); line-height: 1.65;">
          Explore our inventory or message national shooter Pranatpal Singh directly on WhatsApp to discuss current availability, cylinder dates, and weapon fit.
        </p>
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I have a question about how ArmXchange works for acquiring equipment.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp-solid"
          style="padding: 13px 26px; font-size: 0.95rem; gap: 9px;"
        >
          <WhatsAppIcon size={19} />
          <span>Chat on WhatsApp</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 768px) {
    .matrix-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
