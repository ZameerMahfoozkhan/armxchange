---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { PRODUCTS, CATEGORIES, CONTACT_INFO } from '../data/products';

const preOwnedFeatured = PRODUCTS.find(p => p.isPreOwned);
const featuredNewProducts = PRODUCTS.filter(p => !p.isPreOwned && p.featured).slice(0, 6);
---

<Layout 
  title="ArmXchange | Competition 10m Shooting Sports Equipment"
  description="India's specialized platform for competition-grade 10m air rifles, Olympic air pistols, match accessories, and pellets. Inspected cylinder validity and direct consultation with national-level shooter Pranatpal Singh."
>
  <!-- ArmXchange Premium Hero Carousel & Category Navigation -->
  <HeroCarousel />

  <!-- Sporting Disciplines Grid -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="reveal-on-scroll" style="margin-bottom: 36px;">
        <h2 style="margin-bottom: 6px;">Sporting Disciplines</h2>
        <p style="color: var(--color-text-muted);">Curated ISSF match gear across air rifles, air pistols, precision accessories, and match pellets.</p>
      </div>

      <div class="discipline-grid">
        {CATEGORIES.map((cat, idx) => (
          <a href={`/${cat.slug}/`} class={`discipline-card reveal-on-scroll stagger-${idx + 1}`}>
            <div class="img-box">
              <img 
                src={cat.image} 
                alt={`${cat.title} - ISSF Match Equipment & Gear`} 
                width="320"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-signal-red); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px;">
              {cat.tag}
            </div>
            <h3 class="discipline-title">{cat.title}</h3>
            <p class="discipline-desc">{cat.subtitle}</p>
            <div class="discipline-link">
              <span>Explore {cat.count} {cat.count === 1 ? 'Listing' : 'Listings'}</span>
              <span class="arrow-icon">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Pre-Owned Star Spotlight: 2018 Feinwerkbau 800 Alu -->
  {preOwnedFeatured && (
    <section style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-border);">
      <div class="container">
        <div class="reveal-on-scroll" style="margin-bottom: 36px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-signal-red); margin-bottom: 4px;">
              VERIFIED PRE-OWNED SPOTLIGHT
            </div>
            <h2>Championship Ready 2018 Feinwerkbau 800 Alu</h2>
            <p style="color: var(--color-text-muted);">Equipped with brand-new factory 2024 cylinder, valid under ISSF rules through 2034.</p>
          </div>
          <a href="/second-hand-weapons/" class="btn btn-secondary">
            <span>View All Pre-Owned Listings</span>
            <span class="btn-trailing-icon">→</span>
          </a>
        </div>

        <div class="dossier-card reveal-on-scroll">
          <div class="dossier-grid">
            <div class="dossier-media">
              <img 
                src={preOwnedFeatured.images[0]} 
                alt={`${preOwnedFeatured.brand} ${preOwnedFeatured.title} - Certified Pre-Owned 10m Target Air Rifle`} 
                width="640"
                height="420"
                loading="lazy"
                decoding="async"
              />
              <div style="position: absolute; top: 16px; left: 16px; display: flex; flex-direction: column; gap: 6px;">
                <span class="tech-badge tech-badge-preowned">Verified Pre-Owned</span>
                <span class="tech-badge tech-badge-new">2024 Cylinder Installed</span>
              </div>
            </div>

            <div class="dossier-info">
              <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin-bottom: 6px;">
                {preOwnedFeatured.brand} // 10M MATCH AIR RIFLE
              </div>
              <h3 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 12px; color: var(--color-ink);">
                {preOwnedFeatured.title}
              </h3>
              <p style="font-size: 0.94rem; line-height: 1.65; color: var(--color-text-body); margin-bottom: 20px;">
                {preOwnedFeatured.shortDescription} Upgraded with a genuine Feinwerkbau compressed air cylinder manufactured in 2024, providing a full 10-year competition certification window. Includes original travel case and match accessories.
              </p>

              <!-- Technical Verification Table -->
              <table class="spec-table">
                <tbody>
                  <tr>
                    <td class="label">Cylinder Validity</td>
                    <td class="val" style="color: var(--color-signal-green);">2024 Factory Cylinder (Valid to 2034)</td>
                  </tr>
                  <tr>
                    <td class="label">Discipline / Calibre</td>
                    <td class="val">10m Air Rifle · .177 (4.5mm)</td>
                  </tr>
                  <tr>
                    <td class="label">Condition Grade</td>
                    <td class="val">Very Good / Range Tested</td>
                  </tr>
                  <tr>
                    <td class="label">Trigger Mechanism</td>
                    <td class="val">Match 2-Stage Fully Adjustable</td>
                  </tr>
                  <tr>
                    <td class="label">Case & Accessories</td>
                    <td class="val">Original Feinwerkbau Hard Travel Case</td>
                  </tr>
                </tbody>
              </table>

              <div class="dossier-footer-row" style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                <div>
                  <div style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--color-text-muted);">Acquisition Method</div>
                  <div style="font-size: 1.3rem; font-weight: 800; color: var(--color-ink);">Price on Enquiry</div>
                </div>

                <div class="dossier-actions" style="display: flex; flex-wrap: wrap; gap: 10px;">
                  <a 
                    href={`/listing/${preOwnedFeatured.slug}/`}
                    class="btn btn-secondary"
                  >
                    <span>Technical Dossier</span>
                    <span class="btn-trailing-icon">→</span>
                  </a>
                  <a 
                    href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I would like to enquire about the 2018 Feinwerkbau 800 Alu (with 2024 cylinder) on ArmXchange.')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-whatsapp-solid"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
                    </svg>
                    <span>Enquire on WhatsApp</span>
                    <span class="btn-trailing-icon">→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Featured Competition Weapons Grid -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="reveal-on-scroll" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; flex-wrap: wrap; gap: 16px;">
        <div>
          <h2 style="margin-bottom: 6px;">Olympic & Match Catalogue</h2>
          <p style="color: var(--color-text-muted);">Brand-new 10m competition weapons from Walther, Feinwerkbau, Steyr, and Morini.</p>
        </div>
        <a href="/new-weapons/" class="btn btn-secondary">
          <span>View All New Weapons ({PRODUCTS.filter(p => p.category === 'new-weapons').length})</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>

      <div class="product-grid">
        {featuredNewProducts.map((product, idx) => (
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- Founder Perspective & Range Ethics (Architectural Dark Band) -->
  <section style="background: #0B0F17; color: #FFFFFF;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1.25fr 0.85fr; gap: 48px; align-items: center;" class="founder-grid">
        <div class="reveal-on-scroll">
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-signal-red); margin-bottom: 16px;">
            FOUNDER COMMITMENT // PRANATPAL SINGH
          </div>
          <h2 style="color: #FFFFFF; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 20px; line-height: 1.25; font-weight: 800;">
            "Equipment should never be the barrier between a dedicated shooter and an Olympic podium."
          </h2>
          <p style="font-size: 1rem; line-height: 1.7; margin-bottom: 16px; color: #CBD5E1;">
            As a competitive national shooter (and having also begun my coaching journey over the past year), I experienced the uncertainty young Indian athletes encounter when sourcing match equipment. Outdated cylinders, undisclosed pressure drops, and speculative pricing frequently mislead emerging shooters.
          </p>
          <p style="font-size: 0.94rem; line-height: 1.65; margin-bottom: 28px; color: #94A3B8;">
            ArmXchange was founded to establish transparency: item-specific inspections, verified factory cylinder dates, and honest guidance tailored to each athlete’s discipline.
          </p>
          <div>
            <div style="font-size: 1.1rem; font-weight: 700; color: #FFFFFF;">
              {CONTACT_INFO.founder}
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: #94A3B8; margin-top: 2px;">
              {CONTACT_INFO.founderTitle} · {CONTACT_INFO.brandMotto}
            </div>
          </div>
        </div>

        <!-- 3 Pillars of Range Integrity -->
        <div class="reveal-on-scroll stagger-2" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 32px; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.15rem; color: #FFFFFF; margin-bottom: 20px; font-weight: 700;">
            Range Standards
          </h3>
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                01 / Cylinder Expiry Audits
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Every pre-owned pneumatic cylinder is audited against ISSF 10-year safety rules. Zero uncertified pressure vessels.
              </div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                02 / Indian Arms Rules 2016
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Strictly 0.177 calibre target air weapons under 20 Joules (Category III(f)). No cartridge firearms.
              </div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                03 / Technical Equipment Consultation
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Grip sizing, electronic trigger selection, and barrel batch recommendations before any acquisition.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works (Clean 4-Step Architecture) -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="reveal-on-scroll" style="margin-bottom: 36px;">
        <h2 style="margin-bottom: 6px;">How ArmXchange Operates</h2>
        <p style="color: var(--color-text-muted);">A structured, athlete-first workflow designed for accountability.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
        <div class="how-step-card reveal-on-scroll stagger-1">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">01</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Browse Catalogue</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">View genuine equipment photos, technical condition grading, and transparent pricing across all 4 categories.</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-2">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">02</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Review Disclosures</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Check cylinder manufacture dates, regulator stability reports, and applicable GST notes (18% on new weapons for non-renowned shooters).</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-3">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">03</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Athlete Consultation</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Connect directly with founder Pranatpal Singh on WhatsApp with the pre-filled equipment dossier and your athlete requirements.</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-4">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">04</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Compliant Handover</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Shooter eligibility is checked, paperwork verified, and equipment safely transferred in compliance with Indian sports regulations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment Consignment Callout -->
  <section style="background: var(--color-canvas-subtle);">
    <div class="container">
      <div class="consign-callout reveal-on-scroll" style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 48px 36px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; box-shadow: var(--shadow-sm);">
        <div style="max-width: 640px;">
          <h2 style="font-size: 1.6rem; margin-bottom: 8px;">Have Match Equipment to Consign?</h2>
          <p style="color: var(--color-text-body); font-size: 0.95rem; line-height: 1.6;">
            If you are upgrading your rifle or pistol and want your precision weapon to pass to an aspiring junior shooter with verified condition and honest pricing, consign with ArmXchange.
          </p>
        </div>
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I have match equipment that I would like to get inspected and listed on ArmXchange.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          style="padding: 14px 24px; font-size: 0.92rem;"
        >
          <span>Consign Equipment with Us</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .how-step-card {
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-spring), border-color 0.2s ease, box-shadow var(--transition-smooth);
    will-change: transform;
  }
  .how-step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(11, 15, 23, 0.22);
    box-shadow: var(--shadow-md);
  }
  .consign-callout {
    transition: box-shadow var(--transition-smooth), border-color 0.2s ease;
  }
  .consign-callout:hover {
    border-color: rgba(11, 15, 23, 0.2);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 868px) {
    .founder-grid {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
    }
  }
  @media (max-width: 600px) {
    .dossier-footer-row {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 14px !important;
    }
    .dossier-actions {
      width: 100%;
      flex-direction: column;
    }
    .dossier-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
