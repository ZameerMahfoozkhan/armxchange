---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { PRODUCTS, CATEGORIES, CONTACT_INFO } from '../data/products';

// 1. All Pre-Owned Weapons (5 verified 10m match rifles)
const preOwnedWeapons = PRODUCTS.filter(p => p.isPreOwned);

// 2. Olympic & Match Catalogue (Balanced selection of rifles & pistols: Walther, Feinwerkbau, Morini, Steyr)
const featuredNewRifles = PRODUCTS.filter(p => !p.isPreOwned && p.category === 'new-weapons' && p.subcategory === 'air-rifles');
const featuredNewPistols = PRODUCTS.filter(p => !p.isPreOwned && p.category === 'new-weapons' && p.subcategory === 'air-pistols');
const featuredOlympicWeapons = [
  featuredNewRifles.find(p => p.id === 'walther-lg500-anatomic-e') || featuredNewRifles[0],
  featuredNewRifles.find(p => p.id === 'fwb-900-alu-centra') || featuredNewRifles[1],
  featuredNewPistols.find(p => p.id === 'morini-cm200ei') || featuredNewPistols[0],
  featuredNewPistols.find(p => p.id === 'steyr-evo-10e') || featuredNewPistols[1]
].filter(Boolean) as typeof PRODUCTS;

// 3. Precision Shooting Accessories (Sights, Buttplates, Match Footwear)
const featuredAccessories = [
  PRODUCTS.find(p => p.id === 'mec-spy-long'),
  PRODUCTS.find(p => p.id === 'mec-contact-4'),
  PRODUCTS.find(p => p.id === 'sauer-rifle-shoes-perfect-top'),
  PRODUCTS.find(p => p.id === 'ahg-shooting-boots-allround')
].filter(Boolean) as typeof PRODUCTS;
---

<Layout 
  title="Pre-Owned & Second Hand 10m Air Rifles, Pistols | ArmsXchange India"
  description="Buy verified second hand & new 10m air rifles, match air pistols, boots & pellets in India. Inspected cylinder validity with national shooter Pranatpal Singh."
>
  <!-- ArmsXchange Premium Hero Carousel & Category Navigation -->
  <HeroCarousel />

  <!-- Sporting Disciplines Grid -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="reveal-on-scroll" style="margin-bottom: 36px;">
        <h2 style="margin-bottom: 6px;">Sporting Disciplines</h2>
        <p style="color: var(--color-text-muted);">Curated ISSF match gear across air rifles, air pistols, precision accessories, and match pellets.</p>
      </div>

      <div class="discipline-grid">
        {CATEGORIES.map((cat, idx) => (
          <a href={`/${cat.slug}/`} class={`discipline-card reveal-on-scroll stagger-${idx + 1}`}>
            <div class="img-box">
              <img 
                src={cat.image} 
                alt={`${cat.title} - ISSF Match Equipment & Gear`} 
                width="320"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="discipline-tag">
              {cat.tag}
            </div>
            <h3 class="discipline-title">{cat.title}</h3>
            <p class="discipline-desc">{cat.subtitle}</p>
            <div class="discipline-link">
              <span>Explore {cat.count} {cat.count === 1 ? 'Listing' : 'Listings'}</span>
              <span class="discipline-link-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 1: Verified Pre-Owned Weapons -->
  <section style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-border);" id="pre-owned">
    <div class="container">
      <div class="reveal-on-scroll" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #475569; margin-bottom: 4px;">
            VERIFIED HARDWARE // 10M COMPETITION READY
          </div>
          <h2 style="margin-bottom: 6px;">Verified Pre-Owned Weapons</h2>
          <p style="color: var(--color-text-muted);">Directly inspected 10m target air rifles with certified cylinders and transparent condition disclosures.</p>
        </div>
        <a href="/second-hand-weapons/" class="btn btn-secondary">
          <span>View All Pre-Owned ({preOwnedWeapons.length})</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>

      <div class="product-grid">
        {preOwnedWeapons.map((product, idx) => (
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Olympic & Match Catalogue (New Weapons - Rifles & Pistols) -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);" id="olympic-catalogue">
    <div class="container">
      <div class="reveal-on-scroll" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #475569; margin-bottom: 4px;">
            FACTORY SEALED // OLYMPIC & NATIONAL SPEC
          </div>
          <h2 style="margin-bottom: 6px;">Olympic & Match Catalogue</h2>
          <p style="color: var(--color-text-muted);">Brand-new 10m competition rifles & precision match pistols from Walther, Feinwerkbau, Steyr, and Morini.</p>
        </div>
        <a href="/new-weapons/" class="btn btn-secondary">
          <span>View All New Weapons ({PRODUCTS.filter(p => p.category === 'new-weapons').length})</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>

      <div class="product-grid">
        {featuredOlympicWeapons.map((product, idx) => (
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Precision Shooting Accessories -->
  <section style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-border);" id="accessories">
    <div class="container">
      <div class="reveal-on-scroll" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #475569; margin-bottom: 4px;">
            COMPETITION GEAR // TUNING & APPAREL
          </div>
          <h2 style="margin-bottom: 6px;">Precision Shooting Accessories</h2>
          <p style="color: var(--color-text-muted);">ISSF-approved match diopter sights, anatomical buttplates, and competition footwear for peak stability.</p>
        </div>
        <a href="/accessories/" class="btn btn-secondary">
          <span>View All Accessories ({PRODUCTS.filter(p => p.category === 'accessories').length})</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>

      <div class="product-grid">
        {featuredAccessories.map((product, idx) => (
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- Founder Perspective & Range Ethics (Architectural Dark Band) -->
  <section style="background: #0B0F17; color: #FFFFFF;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1.25fr 0.85fr; gap: 48px; align-items: center;" class="founder-grid">
        <div class="reveal-on-scroll">
          <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #94A3B8; margin-bottom: 16px;">
            FOUNDER COMMITMENT // PRANATPAL SINGH
          </div>
          <h2 style="color: #FFFFFF; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 20px; line-height: 1.25; font-weight: 800;">
            "Equipment should never be the barrier between a dedicated shooter and an Olympic podium."
          </h2>
          <p style="font-size: 1rem; line-height: 1.7; margin-bottom: 16px; color: #CBD5E1;">
            As a competitive national shooter (and having also begun my coaching journey over the past year), I experienced the uncertainty young Indian athletes encounter when sourcing match equipment. Outdated cylinders, undisclosed pressure drops, and speculative pricing frequently mislead emerging shooters.
          </p>
          <p style="font-size: 0.94rem; line-height: 1.65; margin-bottom: 28px; color: #94A3B8;">
            ArmsXchange was founded to establish transparency: item-specific inspections, verified factory cylinder dates, and honest guidance tailored to each athlete’s discipline.
          </p>
          <div>
            <div style="font-size: 1.1rem; font-weight: 700; color: #FFFFFF;">
              {CONTACT_INFO.founder}
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: #94A3B8; margin-top: 2px;">
              {CONTACT_INFO.founderTitle} · {CONTACT_INFO.brandMotto}
            </div>
          </div>
        </div>

        <!-- 3 Pillars of Range Integrity -->
        <div class="reveal-on-scroll stagger-2" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 32px; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.15rem; color: #FFFFFF; margin-bottom: 20px; font-weight: 700;">
            Range Standards
          </h3>
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                01 / Cylinder Expiry Audits
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Every pre-owned pneumatic cylinder is audited against ISSF 10-year safety rules. Zero uncertified pressure vessels.
              </div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                02 / Indian Arms Rules 2016
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Strictly 0.177 calibre target air weapons under 20 Joules (Category III(f)). No cartridge firearms.
              </div>
            </div>
            <div>
              <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #FFFFFF; margin-bottom: 4px;">
                03 / Technical Equipment Consultation
              </div>
              <div style="font-size: 0.84rem; color: #94A3B8; line-height: 1.55;">
                Grip sizing, electronic trigger selection, and barrel batch recommendations before any acquisition.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works (Clean 4-Step Architecture) -->
  <section style="background: var(--color-canvas); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="reveal-on-scroll" style="margin-bottom: 36px;">
        <h2 style="margin-bottom: 6px;">How ArmsXchange Operates</h2>
        <p style="color: var(--color-text-muted);">A structured, athlete-first workflow designed for accountability.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
        <div class="how-step-card reveal-on-scroll stagger-1">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">01</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Browse Catalogue</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">View genuine equipment photos, technical condition grading, and transparent pricing across all 4 categories.</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-2">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">02</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Review Disclosures</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Check cylinder manufacture dates, regulator stability reports, and applicable GST notes (18% on new weapons for non-renowned shooters).</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-3">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">03</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Athlete Consultation</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Connect directly with founder Pranatpal Singh on WhatsApp with the pre-filled equipment dossier and your athlete requirements.</p>
        </div>

        <div class="how-step-card reveal-on-scroll stagger-4">
          <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 800; color: var(--color-ink); margin-bottom: 10px;">04</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 6px;">Compliant Handover</h3>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55;">Shooter eligibility is checked, paperwork verified, and equipment safely transferred in compliance with Indian sports regulations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment Consignment Callout -->
  <section style="background: var(--color-canvas-subtle);">
    <div class="container">
      <div class="consign-callout reveal-on-scroll" style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 48px 36px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; box-shadow: var(--shadow-sm);">
        <div style="max-width: 640px;">
          <h2 style="font-size: 1.6rem; margin-bottom: 8px;">Have Match Equipment to Consign?</h2>
          <p style="color: var(--color-text-body); font-size: 0.95rem; line-height: 1.6;">
            If you are upgrading your rifle or pistol and want your precision weapon to pass to an aspiring junior shooter with verified condition and honest pricing, consign with ArmsXchange.
          </p>
        </div>
        <a 
          href={`https://wa.me/${CONTACT_INFO.phoneRaw}?text=${encodeURIComponent('Hi Pranatpal, I have match equipment that I would like to get inspected and listed on ArmsXchange.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          style="padding: 14px 24px; font-size: 0.92rem;"
        >
          <span>Consign Equipment with Us</span>
          <span class="btn-trailing-icon">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .how-step-card {
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-spring), border-color 0.2s ease, box-shadow var(--transition-smooth);
    will-change: transform;
  }
  .how-step-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #0B0F17 0%, #475569 50%, #94A3B8 100%);
    opacity: 0;
    transform: scaleX(0.7);
    transition: opacity 0.25s ease, transform 0.3s var(--ease-spring);
    z-index: 2;
  }
  .how-step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(203, 213, 225, 0.9);
    box-shadow: var(--shadow-md);
  }
  .how-step-card:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }
  .consign-callout {
    transition: box-shadow var(--transition-smooth), border-color 0.2s ease;
  }
  .consign-callout:hover {
    border-color: rgba(11, 15, 23, 0.2);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 868px) {
    .founder-grid {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
    }
  }
</style>
