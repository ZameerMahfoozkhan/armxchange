<script>
  const mainImg = document.getElementById('mainImage') as HTMLImageElement;
  const thumbs = Array.from(document.querySelectorAll('.thumb-btn')) as HTMLElement[];
  const photoCounter = document.getElementById('photoCounter');
  const zoomBtn = document.getElementById('zoomBtn');
  const zoomModal = document.getElementById('zoomModal');
  const modalBackdrop = document.getElementById('modalBackdrop');
  const closeZoomBtn = document.getElementById('closeZoomBtn');
  const zoomModalImg = document.getElementById('zoomModalImg') as HTMLImageElement;
  const prevBtn = document.getElementById('galleryPrevBtn');
  const nextBtn = document.getElementById('galleryNextBtn');

  let currentIndex = 0;

  function setActiveImageIndex(index: number) {
    if (thumbs.length === 0) return;
    currentIndex = ((index % thumbs.length) + thumbs.length) % thumbs.length;
    
    thumbs.forEach((b, i) => {
      const isActive = i === currentIndex;
      b.classList.toggle('active', isActive);
      b.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    const activeBtn = thumbs[currentIndex];
    const newSrc = activeBtn.dataset.img;
    const indexNum = activeBtn.dataset.index || (currentIndex + 1).toString();

    if (photoCounter) {
      photoCounter.textContent = `${indexNum} / ${thumbs.length}`;
    }

    if (newSrc && mainImg && mainImg.getAttribute('src') !== newSrc) {
      mainImg.style.transition = 'opacity 0.15s ease, transform 0.15s ease';
      mainImg.style.opacity = '0.35';
      mainImg.style.transform = 'scale(0.98)';
      setTimeout(() => {
        mainImg.src = newSrc;
        const restoreOpacity = () => {
          mainImg.style.opacity = '1';
          mainImg.style.transform = 'scale(1)';
        };
        if (mainImg.complete) {
          restoreOpacity();
        } else {
          mainImg.onload = restoreOpacity;
        }
        if (zoomModalImg) zoomModalImg.src = newSrc;
      }, 120);
    }
  }

  thumbs.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      setActiveImageIndex(idx);
    });
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setActiveImageIndex(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setActiveImageIndex(currentIndex + 1);
  });

  function openZoom() {
    if (zoomModal) zoomModal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeZoom() {
    if (zoomModal) zoomModal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  zoomBtn?.addEventListener('click', openZoom);
  mainImg?.addEventListener('click', openZoom);
  closeZoomBtn?.addEventListener('click', closeZoom);
  modalBackdrop?.addEventListener('click', closeZoom);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && zoomModal?.classList.contains('is-open')) {
      closeZoom();
    } else if (e.key === 'ArrowLeft' && thumbs.length > 1) {
      setActiveImageIndex(currentIndex - 1);
    } else if (e.key === 'ArrowRight' && thumbs.length > 1) {
      setActiveImageIndex(currentIndex + 1);
    }
  });
</script>
