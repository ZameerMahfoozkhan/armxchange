---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, CONTACT_INFO, getWhatsAppListingUrl, type Product } from '../../data/products';

export async function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const currentUrl = `https://armxchange.in/listing/${product.slug}/`;
const whatsappUrl = getWhatsAppListingUrl(product.title, currentUrl);
const relatedProducts = PRODUCTS
  .filter(p => p.id !== product.id && p.category === product.category)
  .slice(0, 3);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "image": product.images.map(img => new URL(img, "https://armxchange.in").toString()),
  "description": product.fullDescription,
  "brand": {
    "@type": "Brand",
    "name": product.brand
  },
  "category": product.categoryLabel,
  "itemCondition": product.isPreOwned ? "https://schema.org/UsedCondition" : "https://schema.org/NewCondition",
  "offers": {
    "@type": "Offer",
    "url": currentUrl,
    "priceCurrency": "INR",
    ...(product.priceValue > 0 ? { "price": product.priceValue } : {}),
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "itemCondition": product.isPreOwned ? "https://schema.org/UsedCondition" : "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "ArmXchange"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://armxchange.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": product.categoryLabel,
      "item": `https://armxchange.in/${product.category}/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.title,
      "item": currentUrl
    }
  ]
};
---

<Layout
  title={`${product.title} | ${product.brand} | ArmXchange`}
  description={`${product.title} (${product.brand}). ${product.shortDescription} Enquire with founder Pranatpal Singh on WhatsApp.`}
  image={product.images[0]}
  type="product"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container" style="padding-top: 28px; padding-bottom: 88px;">
    <!-- Minimalist Breadcrumb -->
    <nav aria-label="Breadcrumb" class="product-breadcrumb">
      <a href="/">Home</a> 
      <span class="sep">/</span>
      <a href={`/${product.category}/`} style="text-transform: capitalize;">{product.categoryLabel}</a> 
      <span class="sep">/</span>
      <span class="current">{product.title}</span>
    </nav>

    <!-- Main Product Layout Grid -->
    <div class="product-stage-grid">
      <!-- Left Column: Gallery & Verified Hardware Inspection -->
      <div>
        <div class="gallery-frame">
          <div id="mainImageContainer" class="main-image-viewport">
            <img 
              id="mainImage"
              src={product.images[0]} 
              alt={`${product.brand} ${product.title} - ${product.categoryLabel || 'Target Air Weapon'} detail photograph`} 
              class="active-product-image"
              width="800"
              height="500"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            
            <div class="image-overlay-badges">
              {product.isPreOwned ? (
                <span class="tech-badge tech-badge-preowned">Verified Pre-Owned</span>
              ) : (
                <span class="tech-badge tech-badge-new">Brand New Import</span>
              )}
              {product.badge && product.badge !== 'Pre-Owned' && product.badge !== 'Verified Pre-Owned' && product.badge !== 'Brand New' && (
                <span class="tech-badge">
                  {product.badge}
                </span>
              )}
            </div>
            
            <button id="zoomBtn" class="zoom-action-trigger" title="Inspect full-resolution photograph">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
              <span>CLICK TO EXPAND HIGH-RES VIEW</span>
            </button>
          </div>

          <!-- Multi-Image Thumbnails -->
          {product.images.length > 1 && (
            <div class="thumbnail-strip">
              {product.images.map((img, idx) => (
                <button 
                  class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
                  data-img={img}
                  aria-label={`View photo ${idx + 1}`}
                >
                  <img 
                    src={img} 
                    alt={`${product.title} - inspection photograph view ${idx + 1}`} 
                    width="70"
                    height="50"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Indian Arms Rules 2016 Statutory Card -->
        <div class="compliance-box">
          <div class="compliance-icon-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <div class="compliance-title">
              Indian Arms Rules 2016 Compliant (.177 Calibre / 4.5mm)
            </div>
            <p class="compliance-text">
              Strictly engineered for ISSF target sports under Category III(f) of the Indian Arms Rules 2016. Calibre is 0.177 (4.5mm) with muzzle kinetic energy below 20 Joules. No arms licence is required under Ministry of Home Affairs regulations. Direct athlete vetting and compliance consultation prior to handover.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Product Telemetry, Pricing & Concierge -->
      <div class="product-intel-col">
        <div class="product-meta-header">
          <span class="product-meta-brand">{product.brand}</span>
          <span class="meta-dot">/</span>
          <span class="product-meta-sub">{product.subcategoryLabel}</span>
          {product.isPreOwned && (
            <>
              <span class="meta-dot">/</span>
              <span class="product-meta-status">Ref: AX-{product.id.slice(0, 6).toUpperCase()}</span>
            </>
          )}
        </div>

        <h1 class="product-main-heading">
          {product.title}
        </h1>

        <p class="product-lead-text">
          {product.fullDescription}
        </p>

        <!-- Pricing & Acquisition Dossier -->
        <div class="pricing-card">
          <div class="pricing-header-row">
            <div>
              <span class="price-kicker">
                {product.isPreOwned ? 'Verified Equipment Valuation' : 'Official Import Pricing'}
              </span>
              <div class="price-num">
                {product.priceDisplay}
              </div>
            </div>
            <span class="tech-badge">
              {product.isPreOwned ? 'Certified Pre-Owned' : 'Factory Sealed'}
            </span>
          </div>

          {product.taxNote && (
            <div class="pricing-tax-note">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>{product.taxNote}</span>
            </div>
          )}

          <!-- Direct Concierge Actions -->
          <div class="pricing-actions">
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp-solid"
              style="padding: 13px 20px; font-size: 0.95rem; width: 100%; justify-content: center;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.274.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
              <span>Enquire On WhatsApp ({CONTACT_INFO.phoneDisplay})</span>
            </a>

            <a 
              href={`tel:${CONTACT_INFO.phone}`}
              class="btn btn-secondary"
              style="padding: 11px 20px; font-size: 0.9rem; width: 100%; justify-content: center;"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Direct Coach Line: Pranatpal Singh</span>
            </a>
          </div>

          <div class="pricing-guarantee">
            Direct athlete & coach interaction. No payment gateways or unverified checkouts.
          </div>
        </div>

        <!-- Range Inspection Dossier (For Pre-Owned Rifles/Pistols) -->
        {product.conditionDisclosure && product.conditionDisclosure.length > 0 && (
          <div class="dossier-checklist-card">
            <div class="dossier-checklist-header">
              <span class="dossier-checklist-title">
                Hardware Inspection & Condition Report
              </span>
              <span class="tech-badge tech-badge-new">VERIFIED</span>
            </div>
            <ul class="dossier-checklist">
              {product.conditionDisclosure.map(item => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Included Package Accessories -->
        {product.includedItems && product.includedItems.length > 0 && (
          <div class="dossier-checklist-card">
            <div class="dossier-checklist-header">
              <span class="dossier-checklist-title">
                Included Equipment & Accessories
              </span>
              <span class="tech-badge">COMPLETE KIT</span>
            </div>
            <ul class="dossier-checklist package-list">
              {product.includedItems.map(item => (
                <li>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="spec-section-card">
      <div class="spec-section-header">
        <h2 class="spec-section-title">Technical Specifications</h2>
        <span class="tech-badge">ISSF COMPETITION STANDARDS</span>
      </div>
      <div class="spec-metric-grid">
        {Object.entries(product.specifications).map(([key, value]) => (
          <div class="spec-metric-tile">
            <div class="spec-metric-key">{key}</div>
            <div class="spec-metric-val">{value}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Discipline Hardware -->
    {relatedProducts.length > 0 && (
      <div class="related-section">
        <div class="related-header">
          <h2 style="font-size: 1.4rem; color: var(--color-ink);">Related {product.categoryLabel}</h2>
          <a href={`/${product.category}/`} class="related-view-all">
            <span>View All</span>
            <span>&rarr;</span>
          </a>
        </div>
        <div class="product-grid">
          {relatedProducts.map(rel => (
            <ProductCard product={rel} />
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- High-Res Zoom Modal -->
  <div id="zoomModal" class="zoom-modal" role="dialog" aria-modal="true" style="display: none;">
    <div class="zoom-modal-backdrop" id="modalBackdrop"></div>
    <div class="zoom-modal-content">
      <div class="zoom-modal-bar">
        <span class="zoom-modal-title">{product.title} &mdash; High-Resolution View</span>
        <button id="closeZoomBtn" class="close-zoom-btn">ESC / CLOSE &times;</button>
      </div>
      <div class="zoom-img-wrapper">
        <img 
          id="zoomModalImg" 
          src={product.images[0]} 
          alt={`${product.brand} ${product.title} - High-Resolution Full Size Inspection View`} 
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-breadcrumb {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-sans);
  }

  .product-breadcrumb a {
    color: var(--color-ink);
    font-weight: 500;
  }

  .product-breadcrumb a:hover {
    color: var(--color-signal-red);
  }

  .product-breadcrumb .sep {
    color: #CBD5E1;
    font-size: 0.75rem;
  }

  .product-breadcrumb .current {
    color: var(--color-text-muted);
    font-weight: 400;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .product-stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    margin-bottom: 64px;
    align-items: start;
  }

  .gallery-frame {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 16px;
    margin-bottom: 20px;
  }

  .main-image-viewport {
    width: 100%;
    min-height: 520px;
    max-height: 640px;
    border-radius: var(--radius-md);
    background: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 24px;
  }

  .active-product-image {
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--transition-normal);
  }

  .active-product-image:hover {
    transform: scale(1.02);
  }

  .image-overlay-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .zoom-action-trigger {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: #0B0F17;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all var(--transition-fast);
  }

  .zoom-action-trigger:hover {
    background: #1E293B;
    border-color: #CBD5E1;
  }

  .thumbnail-strip {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }

  .thumb-btn {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 4px;
    transition: all var(--transition-fast);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .thumb-btn.active, .thumb-btn:hover {
    border-color: var(--color-ink);
  }

  .compliance-box {
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .compliance-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .compliance-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .compliance-text {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* Right Column Details */
  .product-intel-col {
    display: flex;
    flex-direction: column;
  }

  .product-meta-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .product-meta-brand {
    font-weight: 700;
    color: var(--color-ink);
  }

  .meta-dot {
    color: #CBD5E1;
  }

  .product-main-heading {
    font-size: clamp(1.8rem, 3.2vw, 2.3rem);
    margin-bottom: 14px;
    line-height: 1.2;
    color: var(--color-ink);
    font-weight: 800;
  }

  .product-lead-text {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-body);
    margin-bottom: 24px;
  }

  /* Pricing Box */
  .pricing-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .pricing-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .price-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }

  .price-num {
    font-family: var(--font-sans);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .pricing-tax-note {
    font-size: 0.8rem;
    color: var(--color-text-body);
    background: var(--color-canvas-subtle);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    margin-bottom: 20px;
    border: 1px solid var(--color-border);
    line-height: 1.5;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .pricing-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .pricing-guarantee {
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  /* Checklist Card */
  .dossier-checklist-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 20px;
    margin-bottom: 20px;
  }

  .dossier-checklist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .dossier-checklist-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-sans);
  }

  .dossier-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--color-text-body);
  }

  .dossier-checklist li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.5;
  }

  .dossier-checklist svg {
    color: var(--color-signal-green);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .package-list svg {
    color: var(--color-text-muted);
  }

  /* Technical Specs Table */
  .spec-section-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px;
    margin-bottom: 64px;
  }

  .spec-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
  }

  .spec-section-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .spec-metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .spec-metric-tile {
    background: var(--color-canvas-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
  }

  .spec-metric-key {
    font-family: var(--font-mono);
    font-size: 0.72rem;
