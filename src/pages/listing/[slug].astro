---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { PRODUCTS, CONTACT_INFO, getWhatsAppListingUrl, type Product } from '../../data/products';

export async function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const currentUrl = `https://armsxchange.in/listing/${product.slug}/`;
const whatsappUrl = getWhatsAppListingUrl(product.title, currentUrl);
const relatedProducts = PRODUCTS
  .filter(p => p.id !== product.id && p.category === product.category)
  .slice(0, 4);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.isPreOwned ? `Second Hand ${product.title}` : product.title,
  "image": product.images.map(img => new URL(img, "https://armsxchange.in").toString()),
  "description": product.fullDescription,
  "brand": {
    "@type": "Brand",
    "name": product.brand
  },
  "category": product.categoryLabel,
  "itemCondition": product.isPreOwned ? "https://schema.org/UsedCondition" : "https://schema.org/NewCondition",
  "offers": {
    "@type": "Offer",
    "url": currentUrl,
    "priceCurrency": "INR",
    "price": product.priceValue > 0 ? product.priceValue : 220000,
    "priceValidUntil": "2026-12-31",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "itemCondition": product.isPreOwned ? "https://schema.org/UsedCondition" : "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "ArmsXchange",
      "url": "https://armsxchange.in"
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 3,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "INR"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "IN"
      }
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://armsxchange.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": product.categoryLabel,
      "item": `https://armsxchange.in/${product.category}/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.isPreOwned ? `Second Hand ${product.title}` : product.title,
      "item": currentUrl
    }
  ]
};

const pageTitle = product.isPreOwned
  ? `Second Hand ${product.title} | ArmsXchange India`
  : `${product.title} | ${product.brand} | ArmsXchange`;

const pageDescription = product.isPreOwned
  ? `Verified second hand ${product.title} (${product.brand}). ${product.shortDescription} Enquire with national shooter Pranatpal Singh on WhatsApp.`
  : `${product.title} (${product.brand}). ${product.shortDescription} Enquire with founder Pranatpal Singh on WhatsApp.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={product.images[0]}
  type="product"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container product-page-container">
    <!-- Minimalist Breadcrumb -->
    <nav aria-label="Breadcrumb" class="product-breadcrumb">
      <a href="/">Home</a> 
      <span class="sep">/</span>
      <a href={`/${product.category}/`} style="text-transform: capitalize;">{product.categoryLabel}</a> 
      <span class="sep">/</span>
      <span class="current">{product.title}</span>
    </nav>

    <!-- Main Product Layout Grid -->
    <div class="product-stage-grid">
      <!-- Left Column: Gallery & Verified Hardware Inspection -->
      <div>
        <div class="gallery-frame">
          <div id="mainImageContainer" class="main-image-viewport">
            <img 
              id="mainImage"
              src={product.images[0]} 
              alt={`${product.brand} ${product.title} - ${product.categoryLabel || 'Target Air Weapon'} detail photograph`} 
              class="active-product-image"
              width="800"
              height="500"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            
            <div class="image-overlay-badges">
              {product.isPreOwned ? (
                <span class="tech-badge tech-badge-preowned">Verified Pre-Owned</span>
              ) : (
                <span class="tech-badge tech-badge-new">Brand New Import</span>
              )}
              {product.badge && product.badge !== 'Pre-Owned' && product.badge !== 'Verified Pre-Owned' && product.badge !== 'Brand New' && (
                <span class="tech-badge">
                  {product.badge}
                </span>
              )}
            </div>

            {product.images.length > 1 && (
              <>
                <span class="photo-counter-pill" id="photoCounter">
                  1 / {product.images.length}
                </span>
                <button id="galleryPrevBtn" class="gallery-nav-btn gallery-prev" aria-label="Previous photograph">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <button id="galleryNextBtn" class="gallery-nav-btn gallery-next" aria-label="Next photograph">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </>
            )}
            
            <button id="zoomBtn" class="zoom-action-trigger" title="Inspect full-resolution photograph">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
              <span>EXPAND HIGH-RES</span>
            </button>
          </div>

          <!-- Multi-Image Thumbnails -->
          {product.images.length > 1 && (
            <div class="thumbnail-strip" role="tablist" aria-label="Product image gallery thumbnails">
              {product.images.map((img, idx) => (
                <button 
                  class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
                  data-img={img}
                  data-index={idx + 1}
                  aria-label={`View photo ${idx + 1} of ${product.images.length}`}
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  <img 
                    src={img} 
                    alt={`${product.title} - view angle ${idx + 1}`} 
                    width="70"
                    height="50"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="thumb-index-tag">{idx + 1}</span>
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Indian Arms Rules 2016 Statutory Card -->
        <div class="compliance-box">
          <div class="compliance-icon-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <div class="compliance-title">
              Indian Arms Rules 2016 Compliant (.177 Calibre / 4.5mm)
            </div>
            <p class="compliance-text">
              Strictly engineered for ISSF target sports under Category III(f) of the Indian Arms Rules 2016. Calibre is 0.177 (4.5mm) with muzzle kinetic energy below 20 Joules. No arms licence is required under Ministry of Home Affairs regulations. Direct athlete vetting and compliance consultation prior to handover.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Product Telemetry, Pricing & Concierge -->
      <div class="product-intel-col">
        <div class="product-meta-header">
          <span class="product-meta-brand">{product.brand}</span>
          <span class="meta-dot">/</span>
          <span class="product-meta-sub">{product.subcategoryLabel}</span>
          {product.isPreOwned && (
            <>
              <span class="meta-dot">/</span>
              <span class="product-meta-status">Ref: AX-{product.id.slice(0, 6).toUpperCase()}</span>
            </>
          )}
        </div>

        <h1 class="product-main-heading">
          {product.title}
        </h1>

        <p class="product-lead-text">
          {product.fullDescription}
        </p>

        <!-- Pricing & Acquisition Dossier -->
        <div class="pricing-card">
          <div class="pricing-header-row">
            <div>
              <span class="price-kicker">
                {product.isPreOwned ? 'Verified Equipment Valuation' : 'Official Import Pricing'}
              </span>
              <div class="price-num">
                {product.priceDisplay}
              </div>
            </div>
            <span class="tech-badge">
              {product.isPreOwned ? 'Certified Pre-Owned' : 'Factory Sealed'}
            </span>
          </div>

          {product.taxNote && (
            <div class="pricing-tax-note">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>{product.taxNote}</span>
            </div>
          )}

          <!-- Direct Concierge Actions -->
          <div class="pricing-actions">
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp-solid"
              style="padding: 14px 24px; font-size: 0.98rem; width: 100%; justify-content: center; gap: 10px; font-weight: 700;"
            >
              <WhatsAppIcon size={20} />
              <span>Enquire on WhatsApp</span>
              <span class="btn-trailing-icon">→</span>
            </a>
          </div>

          <div class="pricing-guarantee">
            Direct athlete consultation with founder Pranatpal Singh. No unverified online checkouts.
          </div>
        </div>

        <!-- Range Inspection Dossier (For Pre-Owned Rifles/Pistols) -->
        {product.conditionDisclosure && product.conditionDisclosure.length > 0 && (
          <div class="dossier-checklist-card">
            <div class="dossier-checklist-header">
              <span class="dossier-checklist-title">
                Hardware Inspection & Condition Report
              </span>
              <span class="tech-badge tech-badge-new">VERIFIED</span>
            </div>
            <ul class="dossier-checklist">
              {product.conditionDisclosure.map(item => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Included Package Accessories -->
        {product.includedItems && product.includedItems.length > 0 && (
          <div class="dossier-checklist-card">
            <div class="dossier-checklist-header">
              <span class="dossier-checklist-title">
                Included Equipment & Accessories
              </span>
              <span class="tech-badge">COMPLETE KIT</span>
            </div>
            <ul class="dossier-checklist package-list">
              {product.includedItems.map(item => (
                <li>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- Contextual Athlete Advisory & Cross-Links Module -->
    {product.isPreOwned ? (
      <div class="reveal-on-scroll" style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px 32px; margin-top: 36px; margin-bottom: 24px; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="max-width: 680px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="tech-badge tech-badge-preowned">EQUIPMENT CONTROL ADVISORY</span>
            <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted);">ISSF 10-YEAR RULE</span>
          </div>
          <div style="font-size: 1.05rem; font-weight: 700; color: var(--color-ink); margin-bottom: 6px;">
            Evaluating Second-Hand Match Weapons?
          </div>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body); margin: 0;">
            Never purchase an air rifle with an expired cylinder. Review our <a href="/pre-owned-equipment-guide/" style="color: #2563EB; font-weight: 600; text-decoration: underline;">10-Year Cylinder & Regulator Inspection Guide</a>, or explore the <a href="/blog/walther-lg400-vs-feinwerkbau-800/" style="color: #2563EB; font-weight: 600; text-decoration: underline;">Walther LG400 vs FWB 800 Comparison</a>.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/pre-owned-equipment-guide/" class="btn btn-secondary" style="padding: 9px 16px; font-size: 0.82rem;">
            <span>Read Inspection Guide</span>
            <span class="btn-trailing-icon">→</span>
          </a>
          <a href="/blog/second-hand-10m-air-rifle-price-guide-india/" class="btn btn-secondary" style="padding: 9px 16px; font-size: 0.82rem;">
            <span>2026 Price Matrix</span>
            <span class="btn-trailing-icon">→</span>
          </a>
        </div>
      </div>
    ) : product.category === 'new-weapons' ? (
      <div class="reveal-on-scroll" style="background: var(--color-canvas-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px 32px; margin-top: 36px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="max-width: 680px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span class="tech-badge tech-badge-new">GST SAVINGS FOR ATHLETES</span>
            <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted);">NRAI EXEMPTION</span>
          </div>
          <div style="font-size: 1.05rem; font-weight: 700; color: var(--color-ink); margin-bottom: 6px;">
            Renowned Shooter GST Information
          </div>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--color-text-body); margin: 0;">
            Athletes holding valid NRAI Renowned Shooter credentials import competition rifles and pistols exempt from 18% GST. Read our <a href="/legal/eligibility/" style="color: #2563EB; font-weight: 600; text-decoration: underline;">Import Eligibility Guide</a> or explore our <a href="/blog/" style="color: #2563EB; font-weight: 600; text-decoration: underline;">Technical Journal</a>.
          </p>
        </div>
        <div>
          <a href="/legal/eligibility/" class="btn btn-secondary" style="padding: 9px 16px; font-size: 0.82rem;">
            <span>Check Eligibility</span>
            <span class="btn-trailing-icon">→</span>
          </a>
        </div>
      </div>
    ) : null}

    <!-- Trust & Authenticity Guarantee Grid (Zero AI Slop) -->
    <div class="product-trust-strip reveal-on-scroll">
      <div class="product-trust-item">
        <div class="trust-icon-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </div>
        <div>
          <div class="trust-title">ISSF 10m Target Standard</div>
          <div class="trust-desc">.177 Calibre (4.5mm) match precision certified for state & national championships.</div>
        </div>
      </div>

      <div class="product-trust-item">
        <div class="trust-icon-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <div class="trust-title">Cylinder Safety Audit</div>
          <div class="trust-desc">Factory manufacturing stamp & 10-year hydro-test validity verified on chamber.</div>
        </div>
      </div>

      <div class="product-trust-item">
        <div class="trust-icon-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div>
          <div class="trust-title">Indian Arms Rules 2016</div>
          <div class="trust-desc">Category III(f) compliant (&lt; 20 Joules). No arms licence required under MHA rules.</div>
        </div>
      </div>

      <div class="product-trust-item">
        <div class="trust-icon-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div>
          <div class="trust-title">Shooter Consultation</div>
          <div class="trust-desc">Direct technical vetting with founder Pranatpal Singh before equipment handover.</div>
        </div>
      </div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="spec-section-card reveal-on-scroll">
      <div class="spec-section-header">
        <h2 class="spec-section-title">Technical Specifications</h2>
        <span class="tech-badge">ISSF COMPETITION STANDARDS</span>
      </div>
      <div class="spec-metric-grid">
        {Object.entries(product.specifications).map(([key, value]) => (
          <div class="spec-metric-tile">
            <div class="spec-metric-key">{key}</div>
            <div class="spec-metric-val">{value}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Discipline Hardware -->
    {relatedProducts.length > 0 && (
      <div class="related-section reveal-on-scroll">
        <div class="related-header">
          <h2 style="font-size: 1.35rem; color: var(--color-ink); font-weight: 800;">Related {product.categoryLabel}</h2>
          <a href={`/${product.category}/`} class="related-view-all">
            <span>View All</span>
            <span class="btn-trailing-icon">→</span>
          </a>
        </div>
        <div class="product-grid">
          {relatedProducts.map((rel, idx) => (
            <ProductCard product={rel} class={`reveal-on-scroll stagger-${idx + 1}`} />
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Mobile Sticky Bottom WhatsApp Consultation Bar -->
  <aside class="mobile-sticky-action-bar" aria-label="Mobile Quick Action">
    <div class="mobile-sticky-inner">
      <div class="mobile-sticky-pricing">
        <span class="mobile-sticky-label">{product.isPreOwned ? 'Verified Valuation' : 'Official Pricing'}</span>
        <div class="mobile-sticky-price">
          {product.priceDisplay.toLowerCase().includes('enquire') ? 'Price on Request' : product.priceDisplay}
        </div>
      </div>
      <a 
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-sticky-whatsapp-btn"
        aria-label={`Enquire on WhatsApp about ${product.title}`}
      >
        <WhatsAppIcon size={18} />
        <span>Enquire on WhatsApp</span>
      </a>
    </div>
  </aside>

  <!-- High-Res Zoom Modal -->
  <div id="zoomModal" class="zoom-modal" role="dialog" aria-modal="true">
    <div class="zoom-modal-backdrop" id="modalBackdrop"></div>
    <div class="zoom-modal-content">
      <div class="zoom-modal-bar">
        <span class="zoom-modal-title">{product.title} &mdash; High-Resolution View</span>
        <button id="closeZoomBtn" class="close-zoom-btn">ESC / CLOSE &times;</button>
      </div>
      <div class="zoom-img-wrapper">
        <img 
          id="zoomModalImg" 
          src={product.images[0]} 
          alt={`${product.brand} ${product.title} - High-Resolution Full Size Inspection View`} 
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-page-container {
    padding-top: 28px;
    padding-bottom: 88px;
  }

  .product-breadcrumb {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-sans);
  }

  .product-breadcrumb a {
    color: var(--color-ink);
    font-weight: 500;
  }

  .product-breadcrumb a:hover {
    color: var(--color-signal-red);
  }

  .product-breadcrumb .sep {
    color: #CBD5E1;
    font-size: 0.75rem;
  }

  .product-breadcrumb .current {
    color: var(--color-text-muted);
    font-weight: 400;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .product-stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    margin-bottom: 48px;
    align-items: start;
  }

  .gallery-frame {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 16px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }

  .main-image-viewport {
    width: 100%;
    min-height: 480px;
    max-height: 600px;
    border-radius: var(--radius-md);
    background: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 24px;
  }

  .active-product-image {
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--transition-normal);
  }

  .active-product-image:hover {
    transform: scale(1.02);
  }

  .image-overlay-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    z-index: 2;
  }

  .photo-counter-pill {
