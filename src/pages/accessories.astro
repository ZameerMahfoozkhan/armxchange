---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS } from '../data/products';

const accessories = PRODUCTS.filter(p => p.category === 'accessories');

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Competition Shooting Accessories & Match Footwear",
  "description": "Precision MEC match diopter sights, anatomical buttplates, cheek pieces, and ISSF approved competition shooting boots from Sauer, AHG, and Corami.",
  "numberOfItems": accessories.length,
  "itemListElement": accessories.map((p, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": p.title,
    "url": `https://armsxchange.in/listing/${p.slug}/`
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://armsxchange.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Accessories",
      "item": "https://armsxchange.in/accessories/"
    }
  ]
};
---

<Layout
  title="Competition Shooting Accessories & Footwear | ArmsXchange India"
  description="Precision MEC match diopter sights, anatomical buttplates, cheek pieces, and ISSF approved competition shooting boots from Sauer, AHG, and Corami."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="container" style="padding-top: 28px; padding-bottom: 88px;">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--color-ink); font-weight: 500;">Home</a> 
      <span style="color: #CBD5E1; font-size: 0.75rem;">/</span>
      <span style="color: var(--color-text-muted);">Accessories</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 40px; max-width: 860px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
        <span class="tech-badge">MATCH ACCESSORIES & FOOTWEAR</span>
        <span style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">
          OPTICAL & ERGONOMIC UPGRADES
        </span>
      </div>
      <h1 style="margin-bottom: 16px; font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 800; color: var(--color-ink); letter-spacing: -0.03em;">
        Shooting Accessories & ISSF Footwear
      </h1>
      <p style="font-size: 1.05rem; line-height: 1.65; color: var(--color-text-body);">
        Fine-tune your shooting posture, sight alignment, and stance stability. Explore precision German MEC optical match diopters, variable irises, multi-axis buttplates, and ISSF-compliant shooting footwear from Sauer, ahg-Anschütz, and Corami.
      </p>
    </div>

    <!-- Subcategory Filter Chips -->
    <div style="margin-bottom: 28px; display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
      <button class="filter-chip active" data-filter="all">ALL ACCESSORIES ({accessories.length})</button>
      <button class="filter-chip" data-filter="sights">MATCH SIGHTS & OPTICS ({accessories.filter(p => p.subcategory === 'sights').length})</button>
      <button class="filter-chip" data-filter="footwear">SHOOTING BOOTS ({accessories.filter(p => p.subcategory === 'footwear').length})</button>
      <button class="filter-chip" data-filter="accessories">STOCK HARDWARE ({accessories.filter(p => p.subcategory === 'accessories').length})</button>
    </div>

    <!-- Product Grid -->
    <div id="accessoryGrid" class="product-grid">
      {accessories.map((product, idx) => (
        <div class="accessory-item" data-sub={product.subcategory}>
          <ProductCard product={product} class={`reveal-on-scroll stagger-${(idx % 4) + 1}`} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .filter-chip {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
    padding: 7px 15px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: transform var(--transition-spring), background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow var(--transition-smooth);
    will-change: transform;
  }

  .filter-chip:hover {
    border-color: var(--color-ink);
    transform: translateY(-1px);
  }

  .filter-chip:active {
    transform: scale(0.96) !important;
  }

  .filter-chip.active {
    background: var(--color-ink);
    color: #FFFFFF;
    border-color: var(--color-ink);
    box-shadow: 0 2px 8px rgba(11, 15, 23, 0.18);
  }

  .accessory-item {
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out-expo);
  }
</style>

<script>
  const filterChips = document.querySelectorAll('.filter-chip');
  const items = document.querySelectorAll('.accessory-item');

  function applyFilter(filter: string) {
    let matched = false;
    filterChips.forEach(c => {
      const isTarget = (c as HTMLElement).dataset.filter === filter;
      c.classList.toggle('active', isTarget);
      if (isTarget) matched = true;
    });

    if (!matched) {
      filterChips[0]?.classList.add('active');
      filter = 'all';
    }

    items.forEach(el => {
      const itemEl = el as HTMLElement;
      const sub = itemEl.dataset.sub;
      if (filter === 'all' || sub === filter) {
        itemEl.style.display = 'block';
      } else {
        itemEl.style.display = 'none';
      }
    });
  }

  filterChips.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter || 'all';
      applyFilter(filter);
    });
  });

  // Handle URL query parameters (?category=footwear/boots, ?sub=footwear, ?category=sights/scope, ?category=accessories/stock)
  const searchParams = new URLSearchParams(window.location.search);
  const urlParam = (searchParams.get('category') || searchParams.get('sub') || searchParams.get('filter') || '').toLowerCase();
  if (urlParam) {
    let targetFilter = urlParam;
    if (['footwear', 'boots', 'shoes'].includes(urlParam)) targetFilter = 'footwear';
    if (['sights', 'scope', 'scopes', 'optics', 'diopter'].includes(urlParam)) targetFilter = 'sights';
    if (['accessories', 'stock', 'stocks', 'buttplate', 'hardware'].includes(urlParam)) targetFilter = 'accessories';
    applyFilter(targetFilter);
  }
</script>
